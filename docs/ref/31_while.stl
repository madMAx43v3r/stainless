// C++-style condition-controlled loops. Conditions are checked before every
// iteration, and break/continue target the nearest enclosing loop.

namespace samples {

u32 sum_odd_before(u32 limit)
{
    u32 current = 0;
    u32 total = 0;
    while (current < limit) {
        current += 1;
        if (current == 2) {
            continue;
        }
        if (current == 5) {
            break;
        }
        total += current;
    }
    return total;
}

} // namespace samples
