// Compiler-provided standard collection bindings. List is a doubly linked
// list, Queue is a double-ended queue, and Map/MultiMap/Set retain sorted
// key order.

use rust::{List, Map, MultiMap, Queue, Set};

namespace samples {

i32 collection_order()
{
    // Default construction uses the corresponding Rust collection new().
    List<i32> linked;
    linked.push_back(2);
    linked.push_front(1);

    i32 linked_order = 0;
    for (const auto& value : linked) {
        linked_order = linked_order * 10 + value;
    }

    Queue<i32> pending = Queue::with_capacity(2);
    pending.push_back(4);
    pending.push_front(3);

    i32 queue_order = 0;
    for (const auto& value : pending) {
        queue_order = queue_order * 10 + value;
    }

    Map<i32, i32> lookup;
    lookup.insert(2, 20);
    lookup.insert(1, 10);

    i32 map_key_order = 0;
    i32 map_value_total = 0;
    for (auto& [key, value] : lookup) {
        // Map keys remain immutable even in a mutable structured binding.
        value += key;
    }
    for (const auto& [key, value] : lookup) {
        map_key_order = map_key_order * 10 + key;
        map_value_total += value;
    }
    lookup.retain([](const i32& key) {
        return key > 0;
    });

    Set<i32> sorted;
    sorted.insert(3);
    sorted.insert(1);
    sorted.insert(2);

    i32 set_order = 0;
    for (auto value : sorted) {
        set_order = set_order * 10 + value;
    }

    optional<i32> first = lookup.get(1);
    optional<i32> direct = 12;
    direct = 13;
    if (!first || first.value_or(0) != 11 || direct.value_or(0) != 13 ||
        !sorted.contains(2)) {
        return 0;
    }
    return linked_order + queue_order + map_key_order + map_value_total
        + set_order + i32(lookup.len());
}

i32 copied_and_moved_map_entries()
{
    Map<i32, i32> values;
    values.insert(2, 20);
    values.insert(1, 10);

    i32 total = 0;
    for (auto [key, value] : values) {
        total += key + value;
    }

    Map<i32, i32> consumed = values.clone();
    for (auto [key, value] : move(consumed)) {
        total += key + value;
    }
    return total;
}

i32 mutate_optional(optional<i32>& value)
{
    if (!value) {
        return 0;
    }
    i32& item = value.value();
    item += 1;
    return item;
}

i32 require_optional(optional<i32>& value) throws stainless::OptionalError
{
    return value.value();
}

i32 ordered_map_ranges()
{
    Map<i32, i32> values;
    values.insert(1, 10);
    values.insert(2, 20);
    values.insert(3, 30);

    i32 forward_total = 0;
    usize count = values.with_range(
        1,
        2,
        [&forward_total](const i32& key, const i32& value) {
            forward_total += key + value;
        });
    i32 predecessor = 0;
    values.with_last_before(
        1,
        3,
        [&predecessor](const i32& _key, const i32& value) {
            predecessor = value;
        });
    i32 successor = 0;
    values.with_first_after(
        1,
        3,
        [&successor](const i32& _key, const i32& value) {
            successor = value;
        });
    return forward_total + predecessor + successor + i32(count);
}

i32 ordered_multimap_entries()
{
    MultiMap<i32, i32> values;
    values.insert(2, 20);
    values.insert(1, 10);
    values.insert(2, 21);

    i32 key_order = 0;
    i32 total = 0;
    for (const auto& [key, value] : values) {
        key_order = key_order * 10 + key;
        total += value;
    }

    i32 matching = 0;
    usize match_count = values.with(
        2,
        [&matching](const i32& value) {
            matching += value;
        });
    if (!values.remove(2, 20)) {
        return 0;
    }
    values.retain([](const i32& _key, const i32& value) {
        return value != 20;
    });
    return key_order + total + matching + i32(match_count)
        + i32(values.len()) + i32(values.key_len());
}

} // namespace samples
