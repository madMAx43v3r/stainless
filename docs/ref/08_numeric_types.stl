// Provisional Stainless syntax example.
// Numeric type names follow Rust; floating literal suffixes follow C++.

use rust::Vec;

namespace samples {

i64 add_i64(i64 left, i64 right)
{
    return left + right;
}

u64 next_id(u64 current)
{
    return current + 1;
}

f32 rectangle_area_f32(f32 width, f32 height)
{
    return width * height;
}

f64 average_f64(f64 left, f64 right)
{
    return (left + right) / 2.0;
}

u32 default_integer_literal()
{
    auto value = 42;
    return value;
}

u64 default_large_integer_literal()
{
    auto value = 4294967296;
    return value;
}

i64 default_large_negative_integer_literal()
{
    auto value = -2147483649;
    return value;
}

u8 contextual_integer_literal()
{
    u8 value = 1;
    return value;
}

f64 default_floating_literal()
{
    auto value = 0.5;
    return value;
}

f32 suffixed_floating_literal()
{
    auto value = 0.5f;
    return value;
}

u32 explicit_numeric_cast(i64 value)
{
    // Primitive casts use constructor syntax and Rust conversion semantics.
    return u32(value);
}

usize element_count(const Vec<i32>& values)
{
    return values.len();
}

// Mixed-width arithmetic is invalid without an explicit conversion:
// f64 invalid = 1.0f + 2.0;

} // namespace samples
