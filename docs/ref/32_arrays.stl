// Array<T, N> is compiler-native fixed-size inline storage and lowers directly
// to Rust [T; N]. N is a compile-time usize literal, const parameter, or a
// qualified static const usize member. Index expressions accept unsigned
// integer types up to u64, plus usize, and convert to usize with a checked
// conversion before Rust bounds checking.

namespace samples {

struct Limits {
    static const usize Width = 4;
};

struct Buffer<T, usize N> {
    Array<T, N> values;

    Buffer(Array<T, N> values);
    const Array<T, N>& get() const;
};

Buffer<T, N>::Buffer(Array<T, N> values) : values(move(values))
{
}

const Array<T, N>& Buffer<T, N>::get() const
{
    return values;
}

u32 array_result()
{
    // Missing aggregate elements are default-constructed.
    Array<u32, Limits::Width> values = Array<u32, Limits::Width>{1, 2};
    u32 third = 2;
    u64 fourth = 3;
    values[third] = 3;
    values[fourth] = 4;

    u32 total = 0;
    for (const auto& value : values) {
        total += value;
    }

    Buffer<u32, 4> buffer = Buffer<u32, 4>(values);
    Array<u32, 3> filled;
    filled.fill(5);
    Array<u32, 0> empty;
    if (!empty.empty()) {
        return 0;
    }
    return total + u32(buffer.get().len()) + filled[0];
}

} // namespace samples
