use rust::String;

namespace samples {

enum RecordKind : u8 {
    Insert = 1,
    Update = 2,
    Commit = 3,
};

u32 preserve_encoding(u32 value)
{
    return value;
}

u32 encode_kind(RecordKind kind)
{
    return preserve_encoding(kind);
}

RecordKind decode_kind(u32 value) throws stainless::EnumError
{
    return RecordKind(value);
}

RecordKind decode_kind_name(const String& name) throws stainless::EnumError
{
    return RecordKind(name);
}

String kind_name(RecordKind kind)
{
    return kind.name();
}

String kind_name_explicit(RecordKind kind)
{
    return kind.name();
}

u32 kind_weight(RecordKind kind)
{
    return switch (kind) {
        RecordKind::Insert | RecordKind::Update => 10,
        RecordKind::Commit => 20,
        else => 0,
    };
}

}
