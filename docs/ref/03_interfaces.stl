// Provisional Stainless syntax example.
// Struct interface calls are always static. Classes may additionally be
// converted to dynamically dispatched interface references or owning pointers.

namespace samples {

interface Sized {
    usize size() const;
};

struct Buffer : Sized {
    vector<i32> values;

    usize size() const;
    void push(i32 value);
};

usize Buffer::size() const {
    return values.size();
}

void Buffer::push(i32 value) {
    values.push_back(value);
}

interface Answer {
    i32 value() const;
};

interface NamedAnswer : Answer {
    string name() const;
};

class ConstantAnswer : NamedAnswer {
public:
    i32 value() const;
    string name() const;
};

i32 ConstantAnswer::value() const {
    return 42;
}

string ConstantAnswer::name() const {
    return "constant";
}

unique_ptr<NamedAnswer> make_answer() {
    // Only a class may be erased to an owning interface pointer.
    return make_unique<ConstantAnswer>();
}

i32 read_answer(const NamedAnswer& answer) {
    return answer.value();
}

} // namespace samples

i32 main() {
    unique_ptr<samples::NamedAnswer> answer = samples::make_answer();
    return samples::read_answer(*answer);
}
