// Provisional Stainless syntax example.
// Standard ownership/container types come from the built-in prelude.

namespace samples {

struct Config {
    i32 version;
    string name;
};

Config make_config(i32 version, string name) {
    return Config{version, move(name)};
}

i32 read_version(const Config& config) {
    return config.version;
}

usize vector_example() {
    vector<i32> values;
    values.push_back(10);
    values.push_back(20);

    if (values.empty()) {
        return 0;
    }

    return values.size();
}

i32 unique_example() {
    unique_ptr<Config> owner =
        make_unique<Config>(make_config(1, "development"));

    owner.version = 2;
    i32 borrowed_version = read_version(owner);

    // A reference can exist for a call, but not as a local variable. The
    // parameter borrow has ended, so the unique owner can now move.
    unique_ptr<Config> relocated = move(owner);
    return borrowed_version + relocated.version;
}

i32 shared_example() {
    // shared_ptr default construction creates a null handle.
    shared_ptr<Config> current;

    if (!current) {
        current = make_shared<Config>(make_config(1, "first"));
    }

    // Both paths reaching here establish that current is non-null. Pointee
    // access uses a compiler-generated hidden const Config&.
    shared_ptr<Config> observer = current;

    // shared_ptr copies implicitly. Reassignment replaces only this handle; it
    // does not mutate the Config observed by any other shared pointer.
    current = make_shared<Config>(make_config(2, "second"));

    // observer.version = 3; // Invalid: shared pointees are immutable.
    return observer.version + current.version;
}

} // namespace samples
