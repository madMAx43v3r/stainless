// Provisional Stainless syntax example.
// Standard ownership/container types come from the built-in prelude.

namespace samples {

struct Config {
    i32 version;
    string name;
};

Config make_config(i32 version, string name) {
    return Config{version, move(name)};
}

usize vector_example() {
    vector<i32> values;
    values.push_back(10);
    values.push_back(20);

    if (values.empty()) {
        return 0;
    }

    return values.size();
}

i32 unique_example() {
    unique_ptr<Config> owner =
        make_unique<Config>(make_config(1, "development"));

    owner->version = 2;
    i32 borrowed_version = 0;

    {
        Config& borrowed = *owner;
        borrowed_version = borrowed.version;
    }

    // The borrow has ended, so the unique owner can now move.
    unique_ptr<Config> relocated = move(owner);
    return borrowed_version + relocated->version;
}

i32 shared_example() {
    shared_ptr<Config> current =
        make_shared<Config>(make_config(1, "first"));
    shared_ptr<Config> observer = clone(current);

    // Reassignment replaces only this handle. It does not mutate the Config
    // observed by any other shared pointer.
    current = make_shared<Config>(make_config(2, "second"));

    // observer->version = 3; // Invalid: shared pointees are immutable.
    return observer->version + current->version;
}

} // namespace samples
