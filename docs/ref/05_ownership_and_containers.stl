// Provisional Stainless syntax example.
// Standard ownership/container types come from the built-in prelude.

namespace samples {

struct Config {
    i32 version;
    string name;
};

Config make_config(i32 version, string name) {
    return Config{version, move(name)};
}

i32 read_version(const Config& config) {
    return config.version;
}

usize vector_example() {
    vector<i32> values;
    values.push_back(10).push_back(20);

    if (values.empty()) {
        return 0;
    }

    return values.size();
}

i32 unique_example() {
    unique_ptr<Config> owner =
        make_unique<Config>(make_config(1, "development"));

    owner.version = 2;
    i32 borrowed_version = read_version(owner);

    // This ordinary parameter borrow has ended, so the unique owner can now
    // move. require(...) below is the only local-reference declaration form.
    unique_ptr<Config> relocated = move(owner);
    return borrowed_version + relocated.version;
}

i32 nullable_unique_example() {
    unique_nullptr<Config> maybe;

    if (!maybe) {
        maybe = unique_nullptr<Config>(
            make_unique<Config>(make_config(1, "nullable")));
    }

    // Flow analysis proves non-null, so mutable pointee access is allowed.
    maybe.version = 2;

    // Recovering the non-null unique owner must consume the nullable owner.
    unique_ptr<Config> definite = unique_ptr<Config>(move(maybe));
    return definite.version;
}

i32 guarded_nullable_unique(unique_nullptr<Config> maybe) {
    // The failure block must exit. A mutable unique owner yields Config&.
    auto& config = require(maybe) {
        return -1;
    }

    config.version = 2;
    return config.version;
}

i32 shared_example() {
    // shared_nullptr default construction creates a null handle.
    shared_nullptr<Config> current;

    if (!current) {
        current = shared_nullptr<Config>(
            make_shared<Config>(make_config(1, "first")));
    }

    // Both paths reaching here establish that current is non-null. Pointee
    // access uses a compiler-generated hidden const Config&.
    // Explicit conversion to shared_ptr clones the contained Arc.
    shared_ptr<Config> observer = shared_ptr<Config>(current);

    // Shared handles copy implicitly. Reassignment replaces only this handle;
    // it does not mutate the Config observed by any other shared pointer.
    current = shared_nullptr<Config>(
        make_shared<Config>(make_config(2, "second")));

    // observer.version = 3; // Invalid: shared pointees are immutable.
    return observer.version + current.version;
}

} // namespace samples
