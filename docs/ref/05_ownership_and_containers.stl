// Provisional Stainless syntax example.
// Containers and strings use Rust names/APIs. Ownership uses Stainless's
// restricted unique/shared pointer layer.

use rust::{println, String, Vec};

namespace samples {

struct Config {
    i32 version;
    String name;
};

Config make_config(i32 version, String name)
{
    return Config{version, move(name)};
}

i32 read_version(const Config& config)
{
    return config.version;
}

usize vector_example()
{
    Vec<i32> values;
    values.push(10);
    values.push(20);

    if (values.empty()) {
        return 0;
    }

    return values.len();
}

i32 unique_example()
{
    unique_ptr<Config> owner =
        make_unique<Config>(make_config(1, "development"));

    owner.version = 2;
    i32 borrowed_version = read_version(owner);

    // This ordinary parameter borrow has ended, so the unique owner can now
    // move. require(...) below is the guarded local-reference declaration
    // form; typed catch binders are managed separately by exception handling.
    unique_ptr<Config> relocated = move(owner);
    return borrowed_version + relocated.version;
}

i32 nullable_unique_example()
{
    unique_nullptr<Config> maybe;

    if (!maybe) {
        maybe = unique_nullptr<Config>(
            make_unique<Config>(make_config(1, "nullable")));
    }

    auto& config = require(maybe) {
        return -1;
    }
    config.version = 2;

    // Recovering a non-null unique owner consumes the nullable owner.
    unique_ptr<Config> definite =
        unique_ptr<Config>(move(maybe));
    return definite.version;
}

i32 guarded_nullable_unique(unique_nullptr<Config> maybe)
{
    // The failure block must exit. A nullable unique owner yields mutable T&.
    auto& config = require(maybe) {
        return -1;
    }

    config.version = 2;
    return config.version;
}

void guarded_nullable_unique_void(unique_nullptr<Config> maybe)
{
    // A void failure block runs before its implicit return.
    auto& config = require(maybe) {
        println!("configuration is missing");
    }

    config.version = 2;
}

i32 shared_example()
{
    shared_nullptr<Config> current;

    if (!current) {
        current = shared_nullptr<Config>(
            make_shared<Config>(make_config(1, "first")));
    }

    // Converting the proven-non-null nullable owner copies the Arc handle.
    shared_ptr<Config> observer = shared_ptr<Config>(current);

    // Reassignment replaces only this handle; it does not mutate the Config
    // still observed by observer.
    current = shared_nullptr<Config>(
        make_shared<Config>(make_config(2, "second")));

    const auto& replacement = require(current) {
        return -1;
    }
    return observer.version + replacement.version;
}

} // namespace samples
