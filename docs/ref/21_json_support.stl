// `var` is the compiler-native, owned JSON value type. `null`, JSON arrays,
// and JSON objects are language syntax rather than Rust interop syntax.
use rust::{List, Map, println, String};

struct Entity {
    i32 id;
};

struct Position {
    i32 x;
    i32 y;
};

struct Empty {
};

struct Profile : Entity {
    String name;
    Position position;
    List<String> tags;
    Map<String, i32> metrics;
};

var read_json(const String& source) throws stainless::JsonError
{
    // Assigning Result<var, JsonError> to var performs the normal implicit
    // native Result unwrap and converts the error to stainless::JsonError.
    var parsed = var::parse(source);
    return parsed;
}

var read_json_file(const String& path) throws stainless::JsonError
{
    var parsed = var::parse_file(path);
    return parsed;
}

String encode_json(const var& value)
{
    return value.to_json();
}

bool rejects_cycle(var& value)
{
    try {
        value.self = value;
    } catch (const stainless::JsonError& error) {
        return true;
    }
    return false;
}

bool rejects_scalar_range()
{
    var scalar = 1;
    try {
        for (const var& value : scalar) {
            return value == null;
        }
    } catch (const stainless::JsonError& error) {
        return String(error.message).len() > 0;
    }
    return false;
}

i32 main() throws stainless::JsonError
{
    var object = {
        field: 123,
        "display_name": "Stainless",
        nested: {},
    };
    var array = [1, 2, "text", {}, null];
    var value = 1.23;
    String dynamic_name = "display_name";
    var dynamic_member = object.get(dynamic_name);

    // Dynamic JSON arrays use snapshot iteration. The source can change while
    // borrowed snapshot elements remain stable, and value bindings consume an
    // owned snapshot rather than the source array.
    var ranged = [1, 2, 3];
    i32 borrowed_total = 0;
    for (const var& element : ranged) {
        borrowed_total += i32(element);
        if (i32(element) == 1) {
            ranged.push(4);
        }
    }
    i32 owned_total = 0;
    for (var element : ranged) {
        owned_total += i32(element);
    }

    List<String> tags;
    tags.push_back("compiler");
    tags.push_back("rust");
    Map<String, i32> metrics;
    metrics.insert("answer", 42);
    Profile profile = Profile{
        Entity{7},
        "Ada",
        Position{3, 4},
        move(tags),
        move(metrics),
    };
    // Struct conversion is structural and recursive. Every converted struct
    // object has a fully qualified `__type` member. Inherited data fields are
    // flattened, while nested structs and collections retain their JSON
    // object/array shapes. Converting a named struct uses Stainless copy
    // semantics, so `profile` remains usable.
    var profile_json = var(profile);
    var implicit_profile_json = profile;
    var direct_position_json = var(Position{8, 9});
    var empty_json = var(Empty{});
    bool profile_source_survived = profile.name.len() == 3usize;

    u32 test_index = 2;
    u64 missing_index = 11111;
    var test_element = array[test_index];
    var out_of_bounds = array[missing_index]; // JSON null
    var missing_field = object.not_found; // JSON null

    // Arrays and objects use shared mutable identity. Every mutating operation
    // is checked because wrong kinds, invalid indices, and cycles are errors.
    var shared_object = object;
    object.field = 321;
    object.nested.enabled = true;
    object.set("dynamic", "member");
    array.push(3);
    array.insert(1usize, 7);
    u64 extended_index = 6;
    array[extended_index] = 9; // Extends with null values, like JavaScript.
    var removed_element = array.remove(1usize);
    var removed_member = object.remove("dynamic");
    usize array_length = array.len();
    bool cycle_rejected = rejects_cycle(object);

    // Explicit scalar conversions use JavaScript-compatible JSON coercion.
    i32 test_int = i32(object.field);
    String display_name = String(object.display_name);

    var parsed = read_json("{\"web\":true,\"port\":8080}");
    // `var` copies are cheap. Objects and arrays keep shared Arc identity.
    var shared = parsed;
    String encoded = encode_json(shared);
    println!("{} {} {} {}", display_name, test_int, encoded, value);

    if (i32(shared_object.field) != 321 ||
        i32(shared_object.nested.enabled) != 1 ||
        i32(removed_element) != 7 ||
        String(removed_member).len() != 6usize ||
        array_length != 6usize ||
        !cycle_rejected ||
        String(dynamic_member) != "Stainless" ||
        borrowed_total != 6 ||
        owned_total != 10 ||
        ranged.len() != 4 ||
        !rejects_scalar_range()) {
        return 2;
    }

    if (i32(profile_json.id) != 7 ||
        String(profile_json.name).len() != 3usize ||
        i32(profile_json.position.x) != 3 ||
        String(profile_json.tags[1]).len() != 4usize ||
        i32(profile_json.metrics.answer) != 42 ||
        String(profile_json.__type).len() != 7usize ||
        String(profile_json.position.__type).len() != 8usize ||
        i32(implicit_profile_json.id) != 7 ||
        i32(direct_position_json.y) != 9 ||
        String(empty_json.__type).len() != 5usize ||
        !profile_source_survived) {
        return 3;
    }

    if (test_element == null && out_of_bounds == null && missing_field == null) {
        return 1;
    }
    return 0;
}
