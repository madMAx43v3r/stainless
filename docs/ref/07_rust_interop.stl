// Provisional Stainless syntax example.
// Native Rust APIs enter through the reserved rust namespace. Selected APIs
// from non-standard Cargo dependencies use deterministic generated bindings.

// `regex = "..."` is declared in the surrounding Cargo.toml. Entries in the
// package's versioned stainless-bindings.toml select Regex::new and
// Regex::is_match. Cargo compiles the generated shim against that exact crate.
// External Box/Arc/Weak ownership types would appear at this boundary as the
// corresponding Stainless unique_ptr/shared_ptr/weak_ptr types.
use rust::{String, Vec};
use rust::regex::Regex;

namespace samples {

usize standard_api_example()
{
    Vec<String> values;
    values.push("one");
    values.push("two");
    return values.len();
}

bool external_crate_example(const String& text) throws stainless::RustError
{
    // Regex::new remains a fallible factory because it returns Result rather
    // than Regex. The compiler-adapted unwrap method consumes that temporary
    // and emits an inline checked match. Err becomes the generic RustError
    // using rust::regex::Error's Display text.
    Regex expression = Regex::new("^stainless$").unwrap();
    return expression.is_match(text);
}

bool implicit_external_unwrap(const String& text) throws stainless::RustError
{
    // The explicit Regex destination makes this Result<Regex, E>-to-Regex
    // initialization insert the same checked unwrap intrinsic.
    Regex expression = Regex::new("^stainless$");
    return expression.is_match(text);
}

} // namespace samples
