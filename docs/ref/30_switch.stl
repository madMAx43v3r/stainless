// Exhaustive value selection with C++-styled syntax and Rust-like expression
// semantics. Arms do not fall through, `|` combines literal alternatives, and
// the final `else` arm is required.

use rust::String;

namespace samples {

i32 classify(u8 value)
{
    return switch (value) {
        0 => 10,
        1 => 20,
        else => 30,
    };
}

i32 classify_event(const String& event)
{
    return switch (event) {
        "http" | "ws_open" => 1,
        "ws_message" => 2,
        "ws_close" | "server_error" => 3,
        else => 0,
    };
}

} // namespace samples
