// Provisional Stainless syntax example.
// Structs have a data-only representation. Their member functions are
// declared inside the struct and defined outside it.

namespace samples {

struct Point2 {
    f32 x;
    f32 y;

    f32 length_squared() const;
};

f32 Point2::length_squared() const {
    return x * x + y * y;
}

struct Point3 : Point2 {
    f32 z;

    f32 length_squared() const;
};

f32 Point3::length_squared() const {
    // Data-base fields participate in convenient field lookup.
    return x * x + y * y + z * z;
}

f32 planar_length_squared(const Point2& point) {
    // The static receiver type is Point2, so this selects Point2's function.
    return point.length_squared();
}

f32 example() {
    Point3 point = Point3{Point2{3.0f32, 4.0f32}, 12.0f32};

    // Same-named functions are selected from the static receiver type.
    f32 spatial = point.length_squared();

    // Binding the argument projects Point3 to its Point2 data base. References
    // exist only as parameters, so no local reference declaration is needed.
    f32 projected = planar_length_squared(point);

    // No virtual override occurs through the base reference parameter.
    return spatial + projected;
}

} // namespace samples
