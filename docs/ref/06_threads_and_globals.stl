// Provisional Stainless syntax example.
// Namespace-scope declarations have static storage duration without a
// separate "global" keyword.

namespace samples {

struct Config {
    i32 version;
};

const shared_ptr<Config> startup_config =
    make_shared<Config>(Config{1});

atomic_ptr<Config> required_config =
    atomic_ptr<Config>(startup_config);

atomic_nullptr<Config> current_config =
    atomic_nullptr<Config>(
        shared_nullptr<Config>(startup_config));

thread_local i32 reads_on_this_thread = 0;

i32 read_required(const atomic_ptr<Config>& slot) {
    // Synchronized pointer slots are the sole pointer-handle types that may be
    // passed by reference. This load is always non-null.
    shared_ptr<Config> snapshot = slot.__load();
    return snapshot.version;
}

i32 read_slot(const atomic_nullptr<Config>& slot) {
    // require evaluates __load once, retains its shared snapshot in a hidden
    // owner, and binds snapshot as a non-null const Config&.
    auto& snapshot = require(slot.__load()) {
        return -1;
    }

    return snapshot.version;
}

i32 read_current_version() {
    reads_on_this_thread += 1;
    return read_slot(current_config);
}

void install(shared_nullptr<Config> replacement) {
    current_config.__store(move(replacement));
}

shared_nullptr<Config> exchange(shared_nullptr<Config> replacement) {
    return current_config.__swap(move(replacement));
}

void install_required(shared_ptr<Config> replacement) {
    required_config.__store(move(replacement));
}

shared_ptr<Config> exchange_required(shared_ptr<Config> replacement) {
    return required_config.__swap(move(replacement));
}

void worker(shared_ptr<Config> local) {
    // shared_ptr is non-null; each thread owns its own immutable shared handle.
    i32 version = local.version;
}

void start_worker() {
    // Passing shared_ptr by value implicitly copies its thread-safe handle.
    thread background = spawn(worker, startup_config);
    background.join();
}

} // namespace samples
