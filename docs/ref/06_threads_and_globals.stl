// Provisional Stainless syntax example.
// Namespace-scope declarations have static storage duration without a
// separate "global" keyword.

namespace samples {

struct Config {
    i32 version;
};

const shared_ptr<Config> startup_config =
    make_shared<Config>(Config{1});

atomic_shared_ptr<Config> current_config =
    atomic_shared_ptr<Config>(startup_config);

thread_local i32 reads_on_this_thread = 0;

i32 read_slot(const atomic_shared_ptr<Config>& slot) {
    // Synchronized pointer slots are the sole pointer-handle type that may be
    // passed by reference.
    shared_ptr<Config> snapshot = slot.__load();

    if (!snapshot) {
        return -1;
    }

    return snapshot.version;
}

i32 read_current_version() {
    reads_on_this_thread += 1;
    return read_slot(current_config);
}

void install(shared_ptr<Config> replacement) {
    current_config.__store(move(replacement));
}

shared_ptr<Config> exchange(shared_ptr<Config> replacement) {
    return current_config.__swap(move(replacement));
}

void worker(shared_ptr<Config> local) {
    // Each thread owns its own handle. The pointee remains immutable.
    if (!local) {
        return;
    }

    i32 version = local.version;
}

void start_worker() {
    // Passing shared_ptr by value implicitly copies its thread-safe handle.
    thread background = spawn(worker, startup_config);
    background.join();
}

} // namespace samples
