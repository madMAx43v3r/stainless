// Provisional Stainless syntax example.
// Ownership uses Stainless pointers; thread handles retain Rust API names.

use rust::std::thread;

namespace samples {

struct Config {
    i32 version;
};

// Namespace-scope declarations have static storage duration without a
// separate "global" keyword. Initializers must be compile-time evaluable.
const Config startup_config = Config{1};

// A null atomic slot has a const-evaluable initializer. Allocating an Arc for
// atomic_ptr at namespace scope would require runtime initialization.
atomic_nullptr<Config> current_config;

thread_local i32 reads_on_this_thread = 0;

i32 read_required(const atomic_ptr<Config>& slot) {
    shared_ptr<Config> snapshot = slot.__load();
    return snapshot.version;
}

i32 local_required_example() {
    shared_ptr<Config> initial = make_shared<Config>(Config{1});
    atomic_ptr<Config> required = atomic_ptr<Config>(initial);
    return read_required(required);
}

i32 read_slot(const atomic_nullptr<Config>& slot) {
    // require retains the shared snapshot returned by __load and exposes only
    // its non-null const Config reference.
    const auto& snapshot = require(slot.__load()) {
        return -1;
    }
    return snapshot.version;
}

i32 read_current_version() {
    reads_on_this_thread += 1;
    return read_slot(current_config);
}

void install(shared_nullptr<Config> replacement) {
    current_config.__store(move(replacement));
}

shared_nullptr<Config> exchange(shared_nullptr<Config> replacement) {
    return current_config.__swap(move(replacement));
}

void worker(shared_ptr<Config> local) {
    i32 version = local.version;
}

bool start_worker() {
    // Copying a shared_ptr creates the separate Arc handle captured by the
    // thread. The thread handle itself uses Rust's join/Result API.
    shared_ptr<Config> local = make_shared<Config>(startup_config);
    auto background = thread::spawn([local = move(local)]() {
        worker(move(local));
    });
    auto joined = move(background).join();
    return joined.is_ok();
}

} // namespace samples
