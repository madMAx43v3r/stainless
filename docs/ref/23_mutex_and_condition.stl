// Mutex-protected mutable state and condition notification.
//
// `mutex<T>` and `condition` are compiler-known Stainless types backed by
// Rust's Mutex<T> and Condvar. The lock guard is intentionally inferred: it
// cannot be named, copied, returned, or stored in a struct.

struct SharedState {
    bool ready;
    i32 value;
};

shared_ptr<mutex<SharedState>> new_shared_state() {
    return make_shared<mutex<SharedState>>{false, 0};
}

unique_ptr<mutex<SharedState>> new_unique_state() {
    return make_unique<mutex<SharedState>>{false, 0};
}

shared_ptr<condition> new_condition() {
    return make_shared<condition>();
}

i32 wait_for_value(
    shared_ptr<mutex<SharedState>> state,
    shared_ptr<condition> changed) {
    auto guard = state.lock();

    // Condition waits may wake spuriously, so always re-check the state.
    for (; !guard.ready;) {
        // wait() atomically unlocks the mutex, sleeps, locks it again, and
        // rebinds this same guard before continuing.
        changed.wait(guard);
    }
    return guard.value;
}

void publish_value(
    shared_ptr<mutex<SharedState>> state,
    shared_ptr<condition> changed,
    i32 value) {
    auto guard = state.lock();
    guard.value = value;
    guard.ready = true;
    changed.notify_all();
}
