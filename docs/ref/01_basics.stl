// Provisional Stainless syntax example.
// This file is now an executable lossless-parser fixture. Type checking and
// transpilation are not implemented yet.

namespace samples {

i32 square(i32 value) {
    return value * value;
}

bool is_even(i32 value) {
    return value % 2 == 0;
}

i32 classify(i32 value) {
    if (value < 0) {
        return -1;
    } else if (value == 0) {
        return 0;
    } else {
        return 1;
    }
}

i32 sum_to(i32 limit) {
    i32 total = 0;

    for (i32 current = 0; current < limit; current += 1) {
        total += current;
    }

    return total;
}

} // namespace samples

use crate::samples::{is_even, square, sum_to};

i32 main() {
    i32 squared = square(6);
    i32 sum = sum_to(5);

    if (is_even(squared)) {
        return squared + sum;
    }

    return samples::classify(squared);
}
