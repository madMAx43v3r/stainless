// Explicit-capture callbacks passed through compiler-generated Rust wrappers.
// The companion .bindings.toml file supplies each callback's exact signature,
// invocation capability, and non-escaping lifetime contract.

use rust::callback_fixture::Processor;

namespace samples {

i32 double_value(i32 value) {
    return value * 2;
}

i32 external_callbacks() {
    Processor processor = Processor::new(1);

    i32 total = 3;
    i32 first = processor.apply(4, [&total](i32 value) {
        total += value;
        return total;
    });

    i32 bias = 2;
    i32 second = processor.inspect(5, [adjusted_bias = bias + 0](i32 value) {
        return adjusted_bias + value;
    });

    i32 factor = 3;
    i32 third = processor.apply(2, [multiplier = move(factor)](i32 value) {
        return multiplier * value;
    });

    i32 initial = 1;
    i32 stateful = processor.apply(3, [count = initial](i32 value) mutable {
        count += value;
        return count;
    });

    i32 fourth = processor.apply_fn_ptr(4, double_value);

    i32 offset = 1;
    i32 fifth = move(processor).consume([offset = move(offset)](i32 value) {
        return value + offset;
    });

    // `initial` remains valid because `[count = initial]` copied it.
    return first * 100000 + second * 10000 + third * 1000
        + stateful * 100 + fourth * 10 + fifth + initial;
}

} // namespace samples
