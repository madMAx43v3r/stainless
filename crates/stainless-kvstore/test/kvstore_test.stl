// End-to-end tests for the Stainless kvstore implementation

use rust::std::fs;
use rust::std::thread;
use rust::format;

namespace kvstore {

struct ReaderState {
    i32 successful;
};

namespace test_detail {

Vec<u8> one_byte(u8 value)
{
    Vec<u8> bytes;
    bytes.push(value);
    return bytes;
}

Vec<u8> test_key(u64 value)
{
    Vec<u8> bytes;
    BigEndian::write_u64(bytes, value);
    return bytes;
}

bool value_is(shared_nullptr<Value> maybe, u8 expected)
{
    if (!maybe) {
        return false;
    }
    shared_ptr<Value> value = shared_ptr<Value>(maybe);
    return value.bytes.len() == 1 && value.bytes.contains(expected);
}

void write_history(const String& path) throws IndexCorrupt, ValueTooLarge, stainless::IoError
{
    shared_ptr<RawTable> table = open_table(path);
    table.insert(test_key(7), one_byte(10));
    table.commit(1);
    table.insert(test_key(7), one_byte(20));
    table.commit(2);
    table.revert(1);
}

void read_in_thread(shared_ptr<RawTable> table, shared_ptr<mutex<ReaderState>> result)
{
    try {
        if (value_is(table.find(test_key(7)), 10)) {
            auto guard = result.lock();
            guard.successful += 1;
        }
    } catch (const stainless::IoError& _error) {
    }
}

} // namespace test_detail

i32 self_test(const String& path)
    throws CodecError, IndexCorrupt, ValueTooLarge, stainless::IoError, stainless::ThreadError
{
    String index_path = detail::make_index_path(path);
    if (fs::exists(path)) {
        fs::remove_file(path);
    }
    if (fs::exists(index_path)) {
        fs::remove_file(index_path);
    }
    test_detail::write_history(path);

    shared_ptr<RawTable> recovered = open_table(path);
    if (recovered.current_version() != 1 ||
        !test_detail::value_is(recovered.find(test_detail::test_key(7)), 10)) {
        return 1;
    }

    shared_ptr<mutex<ReaderState>> result =
        make_shared<mutex<ReaderState>>{0};
    auto first = thread::spawn([recovered, result]() {
        test_detail::read_in_thread(recovered, result);
    });
    auto second = thread::spawn([recovered, result]() {
        test_detail::read_in_thread(recovered, result);
    });
    first.join();
    second.join();

    auto guard = result.lock();
    i32 status = 2;
    if (guard.successful == 2) {
        status = 0;
    }

    String json_path = path.clone();
    json_path.push_str(".json");
    String json_index_path = detail::make_index_path(json_path);
    if (fs::exists(json_path)) {
        fs::remove_file(json_path);
    }
    if (fs::exists(json_index_path)) {
        fs::remove_file(json_index_path);
    }
    JsonTable2<u32, u64> json_table = JsonTable2<u32, u64>(
        json_path,
        codecs::u32_key(),
        codecs::u64_key());
    var stored = "typed value";
    json_table.insert(7, 9, stored);
    json_table.commit(1);
    var decoded = var();
    if (!json_table.find(7, 9, decoded) || decoded != "typed value") {
        status = 3;
    }
    var refreshed = "same version";
    json_table.insert(7, 9, refreshed);
    if (!json_table.commit(1) || json_table.commit(0)) {
        status = 19;
    }
    var uncommitted = "uncommitted same version";
    json_table.insert(7, 9, uncommitted);
    JsonTable2<u32, u64> recovered_json_table = JsonTable2<u32, u64>(
        json_path,
        codecs::u32_key(),
        codecs::u64_key());
    if (!recovered_json_table.find(7, 9, decoded) || decoded != "same version") {
        status = 20;
    }

    KeyCodec<Vec<u8>> vector_codec = codecs::u8_key().vec();
    Vec<u8> empty;
    Vec<u8> zero;
    zero.push(0);
    Vec<u8> zero_max = zero.clone();
    zero_max.push(255);
    Vec<u8> one;
    one.push(1);
    Encoded empty_bytes = vector_codec.encode(empty);
    Encoded zero_bytes = vector_codec.encode(zero);
    Encoded zero_max_bytes = vector_codec.encode(zero_max);
    Encoded one_bytes = vector_codec.encode(one);
    if (!empty_bytes.valid || !zero_bytes.valid || !zero_max_bytes.valid || !one_bytes.valid ||
        !(empty_bytes.bytes < zero_bytes.bytes) ||
        !(zero_bytes.bytes < zero_max_bytes.bytes) ||
        !(zero_max_bytes.bytes < one_bytes.bytes)) {
        status = 4;
    }
    DecodedAt<Vec<u8>> decoded_vector = vector_codec.decode(zero_max_bytes.bytes, 0);
    if (!decoded_vector.valid ||
        decoded_vector.offset != zero_max_bytes.bytes.len() ||
        decoded_vector.value != zero_max) {
        status = 5;
    }
    Vec<u8> framed;
    framed.push(99);
    Vec<u8> framed_vector = zero_max_bytes.bytes.clone();
    framed.append(framed_vector);
    framed.push(100);
    DecodedAt<Vec<u8>> decoded_at = vector_codec.decode(framed, 1);
    if (!decoded_at.valid || decoded_at.offset + 1 != framed.len() || decoded_at.value != zero_max) {
        status = 6;
    }

    KeyCodec<Vec<Vec<u8>>> nested_codec = vector_codec.vec();
    Vec<Vec<u8>> nested;
    nested.push(move(zero));
    nested.push(move(zero_max));
    Encoded nested_bytes = nested_codec.encode(nested);
    DecodedAt<Vec<Vec<u8>>> decoded_nested = nested_codec.decode(nested_bytes.bytes, 0);
    if (!nested_bytes.valid ||
        !decoded_nested.valid ||
        decoded_nested.offset != nested_bytes.bytes.len() ||
        decoded_nested.value != nested) {
        status = 7;
    }

    KeyCodec<String> string_codec = codecs::string_key();
    String empty_text;
    String prefix_text = "a";
    String zero_text = "a";
    zero_text.push('\0');
    String extension_text = "aa";
    String unicode_text = "é";
    Encoded empty_text_bytes = string_codec.encode(empty_text);
    Encoded prefix_text_bytes = string_codec.encode(prefix_text);
    Encoded zero_text_bytes = string_codec.encode(zero_text);
    Encoded extension_text_bytes = string_codec.encode(extension_text);
    Encoded unicode_text_bytes = string_codec.encode(unicode_text);
    if (!empty_text_bytes.valid || !prefix_text_bytes.valid || !zero_text_bytes.valid ||
        !extension_text_bytes.valid || !unicode_text_bytes.valid ||
        !(empty_text_bytes.bytes < prefix_text_bytes.bytes) ||
        !(prefix_text_bytes.bytes < zero_text_bytes.bytes) ||
        !(zero_text_bytes.bytes < extension_text_bytes.bytes) ||
        !(extension_text_bytes.bytes < unicode_text_bytes.bytes)) {
        status = 8;
    }
    DecodedAt<String> decoded_text = string_codec.decode(zero_text_bytes.bytes, 0);
    if (!decoded_text.valid ||
        decoded_text.offset != zero_text_bytes.bytes.len() ||
        decoded_text.value != zero_text) {
        status = 9;
    }

    KeyCodec<u32> number_codec = codecs::u32_key();
    Encoded number_bytes = number_codec.encode(42);
    Vec<u8> compound_bytes = unicode_text_bytes.bytes.clone();
    compound_bytes.append(number_bytes.bytes);
    DecodedAt<String> compound_text = string_codec.decode(compound_bytes, 0);
    DecodedAt<u32> compound_number = number_codec.decode(compound_bytes, compound_text.offset);
    if (!compound_text.valid || compound_text.value != unicode_text ||
        !compound_number.valid || compound_number.value != 42 ||
        compound_number.offset != compound_bytes.len()) {
        status = 10;
    }

    Vec<u8> invalid_utf8;
    invalid_utf8.push(255);
    invalid_utf8.push(0);
    invalid_utf8.push(0);
    if (string_codec.decode(invalid_utf8, 0).valid) {
        status = 11;
    }

    String string_path = path.clone();
    string_path.push_str(".strings");
    String string_index_path = detail::make_index_path(string_path);
    if (fs::exists(string_path)) {
        fs::remove_file(string_path);
    }
    if (fs::exists(string_index_path)) {
        fs::remove_file(string_index_path);
    }
    JsonTable1<String> string_table = JsonTable1<String>(string_path, codecs::string_key());
    var string_value = "string key value";
    string_table.insert("alpha", string_value);
    string_table.commit(1);
    var found_string_value = var();
    if (!string_table.find("alpha", found_string_value) ||
        found_string_value != "string key value") {
        status = 12;
    }

    String database_first_path = path.clone();
    database_first_path.push_str(".database-first");
    String database_first_index_path = detail::make_index_path(database_first_path);
    String database_second_path = path.clone();
    database_second_path.push_str(".database-second");
    String database_second_index_path = detail::make_index_path(database_second_path);
    if (fs::exists(database_first_path)) {
        fs::remove_file(database_first_path);
    }
    if (fs::exists(database_first_index_path)) {
        fs::remove_file(database_first_index_path);
    }
    if (fs::exists(database_second_path)) {
        fs::remove_file(database_second_path);
    }
    if (fs::exists(database_second_index_path)) {
        fs::remove_file(database_second_index_path);
    }
    Database database;
    shared_ptr<JsonTable1<String>> database_first = make_shared<JsonTable1<String>>(
        database_first_path,
        codecs::string_key());
    shared_ptr<JsonTable1<u32>> database_second = make_shared<JsonTable1<u32>>(
        database_second_path,
        codecs::u32_key());
    database.add(database_first);
    database.add(database_second);
    var first_database_value = "first table";
    var second_database_value = "second table";
    database_first.insert("key", first_database_value);
    database_second.insert(7, second_database_value);
    if (!database.commit(1) || database.current_version() != 1) {
        status = 13;
    }
    var found_first_database_value = var();
    var found_second_database_value = var();
    if (!database_first.find("key", found_first_database_value) ||
        !database_second.find(7, found_second_database_value) ||
        found_first_database_value != "first table" ||
        found_second_database_value != "second table") {
        status = 14;
    }

    var interrupted_database_value = "interrupted table commit";
    database_first.insert("key", interrupted_database_value);
    if (!database_first.commit(2) || database.current_version() != 1 || database.commit(3)) {
        status = 15;
    }
    if (database.recover() != 1 ||
        database_first.current_version() != 1 ||
        database_second.current_version() != 1) {
        status = 16;
    }
    if (!database_first.find("key", found_first_database_value) ||
        found_first_database_value != "first table") {
        status = 17;
    }
    if (!database.revert(0) || database_first.find("key", found_first_database_value) ||
        database_second.find(7, found_second_database_value)) {
        status = 18;
    }

    fs::remove_file(path);
    fs::remove_file(index_path);
    fs::remove_file(json_path);
    fs::remove_file(json_index_path);
    fs::remove_file(string_path);
    fs::remove_file(string_index_path);
    fs::remove_file(database_first_path);
    fs::remove_file(database_first_index_path);
    fs::remove_file(database_second_path);
    fs::remove_file(database_second_index_path);
    return status;
}

} // namespace kvstore

i32 main() throws stainless::Exception
{
    Vec<u8> nonce = stainless::Random::bytes(8);
    String path = "stainless-kvstore-test";
    for (u8 byte : nonce) {
        path.push_str("-");
        path.push_str(format!("{}", byte));
    }
    path.push_str(".log");
    return kvstore::self_test(path);
}
