// Append-only, versioned key/value storage implemented entirely in Stainless.
//
// Values and their compact index records live in separate append-only files.
// Writes are tagged with the current version. commit(next) syncs the data file
// before appending the durable index commit marker. An in-memory version index
// maps versions to index-WAL commit offsets, so revert(version) seeks directly
// to the selected boundary and reads the discarded suffix sequentially.

use rust::{Map, String, Vec};
use rust::std::fs;
use rust::std::fs::{File, OpenOptions};
use rust::std::thread;
use stainless::BigEndian;

namespace kvstore {

struct Value {
    Vec<u8> bytes;
};

struct ReaderState {
    i32 successful;
};

struct IndexEntry {
    u64 offset;
    u32 length;
};

struct KeyValue {
    Vec<u8> key;
    Vec<u8> value;
};

struct RecordKind {
    static const u8 Insert = 0;
    static const u8 Commit = 1;
};

struct ValueTooLarge : stainless::Exception {
};

struct IndexCorrupt : stainless::Exception {
};

struct Limits {
    static const usize MaxValueLength = 4294967295;
    static const u32 MaxVersion = 4294967295;
};

struct StoreState {
    Map<tuple<Vec<u8>, u32>, IndexEntry> index;
    Map<u32, u64> version_index;
    u32 current_version;
    u64 data_len;
    u64 index_len;
};

class Table {
    Table(const String& path) throws stainless::IoError;

    void recover() const throws stainless::IoError;
    void insert(Vec<u8> key, Vec<u8> value) const throws ValueTooLarge, stainless::IoError;
    bool commit(u32 next_version) const throws stainless::IoError;
    bool revert(u32 version) const throws IndexCorrupt, stainless::IoError;
    u32 current_version() const;
    shared_nullptr<Value> find(const Vec<u8>& key) const throws stainless::IoError;
    Vec<KeyValue> find_range(const Vec<u8>& lower, const Vec<u8>& upper) const throws stainless::IoError;
    Vec<KeyValue> find_range_first(
        const Vec<u8>& lower,
        const Vec<u8>& upper,
        usize count) const throws stainless::IoError;
    Vec<KeyValue> find_range_last(
        const Vec<u8>& lower,
        const Vec<u8>& upper,
        usize count) const throws stainless::IoError;

private:
    File data_log;
    File index_log;
    rwlock<StoreState> state;
};

Table::Table(const String& path)
    : data_log(detail::open_log(path)),
      index_log(detail::open_log(detail::make_index_path(path))),
      state(detail::initial_state())
{
}

void Table::insert(Vec<u8> key, Vec<u8> value) const
{
    if (value.len() > Limits::MaxValueLength) {
        throw ValueTooLarge{
            stainless::Exception("encoded value exceeds the u32 length limit")
        };
    }
    auto guard = state.write();
    u32 version = guard.current_version;
    Vec<u8> data_record = detail::make_data_record(version, key, value);
    u64 offset = guard.data_len + 21 + u64(key.len());
    u64 data_len = guard.data_len + u64(data_record.len());
    detail::InsertRecord insert = detail::InsertRecord{
        version,
        offset,
        u32(value.len()),
        move(key)
    };
    Vec<u8> index_record = insert.write();
    data_log.pwrite_all(guard.data_len, data_record);
    index_log.pwrite_all(guard.index_len, index_record);
    guard.data_len = data_len;
    guard.index_len += u64(index_record.len());
    guard.index.insert(
        tuple<Vec<u8>, u32>(move(insert.key), insert.version),
        IndexEntry{insert.offset, insert.length});
}

bool Table::commit(u32 next_version) const
{
    auto guard = state.write();
    if (next_version <= guard.current_version) {
        return false;
    }
    detail::CommitRecord commit = detail::CommitRecord{
        next_version,
        guard.data_len
    };
    Vec<u8> record = commit.write();
    u64 version_offset = guard.index_len;
    data_log.set_len(guard.data_len);
    data_log.sync_data();
    index_log.set_len(guard.index_len);
    index_log.pwrite_all(guard.index_len, record);
    guard.index_len += u64(record.len());
    index_log.set_len(guard.index_len);
    index_log.sync_data();
    guard.version_index.insert(next_version, version_offset);
    guard.current_version = next_version;
    return true;
}

bool Table::revert(u32 version) const
{
    auto guard = state.write();
    if (version > guard.current_version) {
        return false;
    }
    u64 marker_offset = 0;
    bool exact_version = guard.version_index.with(
        version,
        [&marker_offset](const u64& offset) {
            marker_offset = offset;
        });
    u64 boundary = 0;
    u64 data_len = 0;
    if (!exact_version) {
        bool found_successor = guard.version_index.with_first_in_range(
            version,
            Limits::MaxVersion,
            [&marker_offset](const u32& _indexed_version, const u64& offset) {
                marker_offset = offset;
            });
        if (!found_successor) {
            throw IndexCorrupt{
                stainless::Exception("missing successor version offset")
            };
        }
    }
    if (version != 0 || !exact_version) {
        Vec<u8> marker_bytes = detail::read_index_record_at(index_log, marker_offset, guard.index_len);
        detail::CommitRecord marker = detail::CommitRecord::read(marker_bytes);
        if ((exact_version && marker.version != version) || (!exact_version && marker.version <= version)) {
            throw IndexCorrupt{
                stainless::Exception("invalid indexed commit marker")
            };
        }
        boundary = marker_offset;
        if (exact_version) {
            boundary += u64(marker_bytes.len());
        }
        data_len = marker.data_len;
    }

    Vec<tuple<Vec<u8>, u32>> removed;
    Vec<u32> removed_versions;
    for (u64 scan_offset = boundary; scan_offset < guard.index_len;) {
        Vec<u8> record = detail::read_index_record_at(
            index_log,
            scan_offset,
            guard.index_len);
        u8 kind = detail::index_record_kind(record);
        if (kind == RecordKind::Insert) {
            detail::InsertRecord insert = detail::InsertRecord::read(record);
            removed.push(tuple<Vec<u8>, u32>(
                move(insert.key),
                insert.version));
        } else if (kind == RecordKind::Commit) {
            detail::CommitRecord commit = detail::CommitRecord::read(record);
            removed_versions.push(commit.version);
        } else {
            throw IndexCorrupt{
                stainless::Exception("unknown index WAL record kind")
            };
        }
        scan_offset += u64(record.len());
    }

    index_log.set_len(boundary);
    u64 new_index_len = boundary;
    if (!exact_version) {
        detail::CommitRecord commit = detail::CommitRecord{version, data_len};
        Vec<u8> marker = commit.write();
        index_log.pwrite_all(boundary, marker);
        new_index_len += u64(marker.len());
        index_log.set_len(new_index_len);
    }
    index_log.sync_data();

    for (const auto& index_key : removed) {
        guard.index.remove(index_key);
    }
    for (auto removed_version : removed_versions) {
        guard.version_index.remove(removed_version);
    }
    if (!exact_version) {
        guard.version_index.insert(version, boundary);
    }
    guard.current_version = version;
    guard.data_len = data_len;
    guard.index_len = new_index_len;
    data_log.set_len(data_len);
    data_log.sync_data();
    return true;
}

u32 Table::current_version() const
{
    auto guard = state.read();
    return guard.current_version;
}

shared_nullptr<Value> Table::find(const Vec<u8>& key) const
{
    auto guard = state.read();
    bool found = false;
    u64 best_offset = 0;
    u32 best_length = 0;
    u32 current_version = guard.current_version;

    tuple<Vec<u8>, u32> lower = tuple<Vec<u8>, u32>(key.clone(), 0);
    tuple<Vec<u8>, u32> upper = tuple<Vec<u8>, u32>(
        key.clone(),
        current_version);
    guard.index.with_last_in_range(
        lower,
        upper,
        [&found,
         &best_offset,
         &best_length](
            const tuple<Vec<u8>, u32>& _index_key,
            const IndexEntry& location) {
            found = true;
            best_offset = location.offset;
            best_length = location.length;
        });
    if (!found) {
        return nullptr;
    }
    return shared_nullptr<Value>(
        make_shared<Value>{data_log.pread_exact(best_offset, usize(best_length))});
}

Vec<KeyValue> Table::find_range(const Vec<u8>& lower, const Vec<u8>& upper) const
{
    auto guard = state.read();
    u32 current_version = guard.current_version;
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool has_candidate = false;
    Vec<u8> candidate_key;
    IndexEntry candidate_location = IndexEntry{0, 0};

    guard.index.with_range(
        index_lower,
        index_upper,
        [&entries,
         &has_candidate,
         &candidate_key,
         &candidate_location](
            const tuple<Vec<u8>, u32>& index_key,
            const IndexEntry& location) {
            if (!has_candidate || candidate_key != index_key.0) {
                if (has_candidate) {
                    entries.push(tuple<Vec<u8>, IndexEntry>(
                        candidate_key.clone(),
                        candidate_location));
                }
                candidate_key = index_key.0.clone();
                has_candidate = true;
            }
            candidate_location = location;
        });
    if (has_candidate) {
        entries.push(tuple<Vec<u8>, IndexEntry>(
            move(candidate_key),
            candidate_location));
    }
    return detail::read_key_values(data_log, entries);
}

Vec<KeyValue> Table::find_range_last(
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) const
{
    auto guard = state.read();
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), guard.current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool include_upper = true;

    for (; entries.len() < count;) {
        bool found = false;
        Vec<u8> key;
        IndexEntry location = IndexEntry{0, 0};
        if (include_upper) {
            found = guard.index.with_last_in_range(
                index_lower,
                index_upper,
                [&key, &location](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& selected) {
                    key = index_key.0.clone();
                    location = selected;
                });
            include_upper = false;
        } else {
            found = guard.index.with_last_before(
                index_lower,
                index_upper,
                [&key, &location](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& selected) {
                    key = index_key.0.clone();
                    location = selected;
                });
        }
        if (!found) {
            break;
        }
        entries.push(tuple<Vec<u8>, IndexEntry>(key.clone(), location));
        index_upper = tuple<Vec<u8>, u32>(move(key), 0);
    }
    return detail::read_key_values(data_log, entries);
}

Vec<KeyValue> Table::find_range_first(
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) const
{
    auto guard = state.read();
    u32 current_version = guard.current_version;
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool include_lower = true;

    for (; entries.len() < count;) {
        bool found = false;
        Vec<u8> key;
        if (include_lower) {
            found = guard.index.with_first_in_range(
                index_lower,
                index_upper,
                [&key](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& _selected) {
                    key = index_key.0.clone();
                });
            include_lower = false;
        } else {
            found = guard.index.with_first_after(
                index_lower,
                index_upper,
                [&key](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& _selected) {
                    key = index_key.0.clone();
                });
        }
        if (!found) {
            break;
        }

        IndexEntry location = IndexEntry{0, 0};
        tuple<Vec<u8>, u32> key_lower = tuple<Vec<u8>, u32>(key.clone(), 0);
        tuple<Vec<u8>, u32> key_upper = tuple<Vec<u8>, u32>(key.clone(), current_version);
        found = guard.index.with_last_in_range(
            key_lower,
            key_upper,
            [&location](
                const tuple<Vec<u8>, u32>& _index_key,
                const IndexEntry& selected) {
                location = selected;
            });
        if (!found) {
            break;
        }
        entries.push(tuple<Vec<u8>, IndexEntry>(key.clone(), location));
        index_lower = tuple<Vec<u8>, u32>(move(key), current_version);
    }
    return detail::read_key_values(data_log, entries);
}

shared_ptr<Table> open_table(const String& path) throws stainless::IoError
{
    shared_ptr<Table> table = make_shared<Table>(path);
    table.recover();
    return table;
}

void Table::recover() const
{
    auto guard = state.write();
    u64 data_file_len = data_log.len();
    u64 index_file_len = index_log.len();
    u64 offset = 0;
    u64 committed_index_len = 0;
    u64 committed_data_len = 0;
    u32 committed_version = 0;
    Map<tuple<Vec<u8>, u32>, IndexEntry> working;
    Map<u32, u64> recovered_version_index;
    recovered_version_index.insert(0, 0);
    Vec<tuple<Vec<u8>, u32>> pending;

    for (; offset < index_file_len;) {
        try {
            Vec<u8> record = detail::read_index_record_at(
                index_log,
                offset,
                index_file_len);
            u64 next_offset = offset + u64(record.len());
            u8 kind = detail::index_record_kind(record);
            if (kind == RecordKind::Insert) {
                detail::InsertRecord insert = detail::InsertRecord::read(record);
                if (insert.offset > data_file_len ||
                    u64(insert.length) > data_file_len - insert.offset) {
                    break;
                }
                pending.push(tuple<Vec<u8>, u32>(
                    insert.key.clone(),
                    insert.version));
                working.insert(
                    tuple<Vec<u8>, u32>(move(insert.key), insert.version),
                    IndexEntry{insert.offset, insert.length});
            } else if (kind == RecordKind::Commit) {
                detail::CommitRecord commit = detail::CommitRecord::read(record);
                if (commit.data_len > data_file_len) {
                    break;
                }
                pending.clear();
                recovered_version_index.insert(commit.version, offset);
                committed_version = commit.version;
                committed_data_len = commit.data_len;
                committed_index_len = next_offset;
            } else {
                break;
            }
            offset = next_offset;
        } catch (const IndexCorrupt& _error) {
            break;
        }
    }

    for (const auto& index_key : pending) {
        working.remove(index_key);
    }
    if (index_file_len != committed_index_len) {
        index_log.set_len(committed_index_len);
        index_log.sync_data();
    }
    if (data_file_len != committed_data_len) {
        data_log.set_len(committed_data_len);
        data_log.sync_data();
    }
    guard.index = move(working);
    guard.version_index = move(recovered_version_index);
    guard.current_version = committed_version;
    guard.data_len = committed_data_len;
    guard.index_len = committed_index_len;
}

void insert_bytes(shared_ptr<Table> table, Vec<u8> key, Vec<u8> value) throws ValueTooLarge, stainless::IoError
{
    table.insert(move(key), move(value));
}

shared_nullptr<Value> find_bytes(shared_ptr<Table> table, const Vec<u8>& key) throws stainless::IoError
{
    return table.find(key);
}

Vec<KeyValue> find_range_bytes(
    shared_ptr<Table> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper) throws stainless::IoError
{
    return table.find_range(lower, upper);
}

Vec<KeyValue> find_range_last_bytes(
    shared_ptr<Table> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) throws stainless::IoError
{
    return table.find_range_last(lower, upper, count);
}

Vec<KeyValue> find_range_first_bytes(
    shared_ptr<Table> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) throws stainless::IoError
{
    return table.find_range_first(lower, upper, count);
}

bool commit_table(shared_ptr<Table> table, u32 version) throws stainless::IoError
{
    return table.commit(version);
}

bool revert_table(shared_ptr<Table> table, u32 version) throws IndexCorrupt, stainless::IoError
{
    return table.revert(version);
}

u32 table_version(shared_ptr<Table> table)
{
    return table.current_version();
}

namespace detail {

struct InsertRecord {
    // Version in which this key/value pair was written.
    u32 version;
    // First byte of the value in the data WAL.
    u64 offset;
    // Number of value bytes in the data WAL.
    u32 length;
    // Logical key used by the in-memory ordered index.
    Vec<u8> key;

    static InsertRecord read(const Vec<u8>& bytes) throws IndexCorrupt;
    Vec<u8> write() const throws stainless::IoError;
};

struct CommitRecord {
    // Version made current by this commit marker.
    u32 version;
    // Durable data-WAL length at this commit boundary.
    u64 data_len;

    static CommitRecord read(const Vec<u8>& bytes) throws IndexCorrupt;
    Vec<u8> write() const;
};

Vec<u8> InsertRecord::write() const
{
    Vec<u8> payload;
    payload.push(RecordKind::Insert);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, offset);
    BigEndian::write_u32(payload, length);
    BigEndian::write_u64(payload, key.len());
    payload.extend_from_slice(key);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, payload.len() + 8);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

Vec<u8> CommitRecord::write() const
{
    Vec<u8> payload;
    payload.push(RecordKind::Commit);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, data_len);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, 21);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

InsertRecord InsertRecord::read(const Vec<u8>& record)
{
    u32 record_size = decode_u32_at(record, 0);
    if (index_record_kind(record) != RecordKind::Insert ||
        record_size < 33 || usize(record_size) != record.len()) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL insert record")
        };
    }
    u64 key_length = decode_u64_at(record, 21);
    if (u64(record_size) != 33 + key_length) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL key length")
        };
    }

    Vec<u8> key = record.copy_range(29, record.len() - 4);
    return InsertRecord{
        decode_u32_at(record, 5),
        decode_u64_at(record, 9),
        decode_u32_at(record, 17),
        move(key)
    };
}

CommitRecord CommitRecord::read(const Vec<u8>& record)
{
    if (record.len() != 21 ||
        decode_u32_at(record, 0) != 21 ||
        index_record_kind(record) != RecordKind::Commit) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL commit record")
        };
    }
    return CommitRecord{
        decode_u32_at(record, 5),
        decode_u64_at(record, 9)
    };
}

u32 record_checksum_range(const Vec<u8>& record, usize begin, usize end)
{
    u32 sum = 1;
    u32 weighted_sum = 0;
    record.with_range(
        begin,
        end,
        [&sum, &weighted_sum](const u8& byte) {
            sum = (sum + u32(byte)) % 65521;
            weighted_sum = (weighted_sum + sum) % 65521;
        });
    return weighted_sum * 65536 + sum;
}

u32 record_checksum(const Vec<u8>& payload)
{
    return record_checksum_range(payload, 0, payload.len());
}

Vec<u8> make_data_record(u32 version, const Vec<u8>& key, const Vec<u8>& value) throws stainless::IoError
{
    Vec<u8> payload;
    payload.push(RecordKind::Insert);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, key.len());
    BigEndian::write_u32(payload, value.len());
    payload.extend_from_slice(key);
    payload.extend_from_slice(value);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, payload.len() + 8);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

StoreState initial_state()
{
    StoreState state = StoreState{
        Map<tuple<Vec<u8>, u32>, IndexEntry>(),
        Map<u32, u64>(),
        0,
        0,
        0
    };
    state.version_index.insert(0, 0);
    return state;
}

String make_index_path(const String& path)
{
    String result = path.clone();
    result.push_str(".index");
    return result;
}

File open_log(const String& path) throws stainless::IoError
{
    OpenOptions options;
    options.read(true);
    options.write(true);
    options.create(true);
    return options.open(path);
}

u8 decode_u8_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u8_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u8 field")};
    }
}

u32 decode_u32_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u32_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u32 field")};
    }
}

u64 decode_u64_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u64_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u64 field")};
    }
}

u8 index_record_kind(const Vec<u8>& record) throws IndexCorrupt
{
    return decode_u8_at(record, 4);
}

Vec<u8> read_index_record_at(
    const File& index_log,
    u64 start,
    u64 file_len) throws IndexCorrupt, stainless::IoError
{
    if (start > file_len || file_len - start < 4) {
        throw IndexCorrupt{
            stainless::Exception("truncated index WAL record header")
        };
    }
    u32 record_size = decode_u32_at(index_log.pread_exact(start, 4), 0);
    if (record_size < 21 || u64(record_size) > file_len - start) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL record size")
        };
    }
    Vec<u8> record = index_log.pread_exact(start, usize(record_size));
    if (decode_u32_at(record, 0) != record_size) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL record framing")
        };
    }
    usize checksum_offset = record.len() - 4;
    u32 expected_checksum = decode_u32_at(record, checksum_offset);
    if (record_checksum_range(record, 4, checksum_offset) != expected_checksum) {
        throw IndexCorrupt{
            stainless::Exception("index WAL checksum mismatch")
        };
    }
    return record;
}

Vec<KeyValue> read_key_values(
    const File& data_log,
    const Vec<tuple<Vec<u8>, IndexEntry>>& entries) throws stainless::IoError
{
    Vec<KeyValue> values;
    for (const auto& entry : entries) {
        values.push(KeyValue{
            entry.0.clone(),
            data_log.pread_exact(entry.1.offset, usize(entry.1.length))
        });
    }
    return values;
}

Vec<u8> one_byte(u8 value)
{
    Vec<u8> bytes;
    bytes.push(value);
    return bytes;
}

Vec<u8> test_key(u64 value)
{
    Vec<u8> bytes;
    BigEndian::write_u64(bytes, value);
    return bytes;
}

bool value_is(shared_nullptr<Value> maybe, u8 expected)
{
    if (!maybe) {
        return false;
    }
    shared_ptr<Value> value = shared_ptr<Value>(maybe);
    return value.bytes.len() == 1 && value.bytes.contains(expected);
}

void write_history(const String& path) throws IndexCorrupt, ValueTooLarge, stainless::IoError
{
    shared_ptr<Table> table = open_table(path);
    table.insert(test_key(7), one_byte(10));
    table.commit(1);
    table.insert(test_key(7), one_byte(20));
    table.commit(2);
    table.revert(1);
}

void read_in_thread(shared_ptr<Table> table, shared_ptr<mutex<ReaderState>> result)
{
    try {
        if (value_is(table.find(test_key(7)), 10)) {
            auto guard = result.lock();
            guard.successful += 1;
        }
    } catch (const stainless::IoError& error) {
    }
}

} // namespace detail

i32 self_test(const String& path)
    throws IndexCorrupt, ValueTooLarge, stainless::IoError, stainless::ThreadError
{
    String index_path = detail::make_index_path(path);
    if (fs::exists(path)) {
        fs::remove_file(path);
    }
    if (fs::exists(index_path)) {
        fs::remove_file(index_path);
    }
    detail::write_history(path);

    shared_ptr<Table> recovered = open_table(path);
    if (recovered.current_version() != 1 ||
        !detail::value_is(recovered.find(detail::test_key(7)), 10)) {
        return 1;
    }

    shared_ptr<mutex<ReaderState>> result =
        make_shared<mutex<ReaderState>>{0};
    auto first = thread::spawn([recovered, result]() {
        detail::read_in_thread(recovered, result);
    });
    auto second = thread::spawn([recovered, result]() {
        detail::read_in_thread(recovered, result);
    });
    first.join();
    second.join();

    auto guard = result.lock();
    i32 status = 2;
    if (guard.successful == 2) {
        status = 0;
    }
    fs::remove_file(path);
    fs::remove_file(index_path);
    return status;
}

} // namespace kvstore
