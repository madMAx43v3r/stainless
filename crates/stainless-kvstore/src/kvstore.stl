} // namespace codecs

namespace detail {

struct InsertRecord {
    // Version in which this key/value pair was written.
    u32 version;
    // First byte of the value in the data WAL.
    u64 offset;
    // Number of value bytes in the data WAL.
    u32 length;
    // Logical key used by the in-memory ordered index.
    Vec<u8> key;

    static InsertRecord read(const Vec<u8>& bytes) throws IndexCorrupt;
    Vec<u8> write() const throws stainless::IoError;
};

struct CommitRecord {
    // Version made current by this commit marker.
    u32 version;
    // Durable data-WAL length at this commit boundary.
    u64 data_len;

    static CommitRecord read(const Vec<u8>& bytes) throws IndexCorrupt;
    Vec<u8> write() const;
};

Vec<u8> InsertRecord::write() const
{
    Vec<u8> payload;
    payload.push(RecordKind::Insert);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, offset);
    BigEndian::write_u32(payload, length);
    BigEndian::write_u64(payload, key.len());
    payload.extend_from_slice(key);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, payload.len() + 8);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

Vec<u8> CommitRecord::write() const
{
    Vec<u8> payload;
    payload.push(RecordKind::Commit);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, data_len);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, 21);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

InsertRecord InsertRecord::read(const Vec<u8>& record)
{
    u32 record_size = decode_u32_at(record, 0);
    if (index_record_kind(record) != RecordKind::Insert ||
        record_size < 33 || usize(record_size) != record.len()) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL insert record")
        };
    }
    u64 key_length = decode_u64_at(record, 21);
    if (u64(record_size) != 33 + key_length) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL key length")
        };
    }

    Vec<u8> key = record.copy_range(29, record.len() - 4);
    return InsertRecord{
        decode_u32_at(record, 5),
        decode_u64_at(record, 9),
        decode_u32_at(record, 17),
        move(key)
    };
}

CommitRecord CommitRecord::read(const Vec<u8>& record)
{
    if (record.len() != 21 ||
        decode_u32_at(record, 0) != 21 ||
        index_record_kind(record) != RecordKind::Commit) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL commit record")
        };
    }
    return CommitRecord{
        decode_u32_at(record, 5),
        decode_u64_at(record, 9)
    };
}

u32 record_checksum_range(const Vec<u8>& record, usize begin, usize end)
{
    u32 sum = 1;
    u32 weighted_sum = 0;
    record.with_range(
        begin,
        end,
        [&sum, &weighted_sum](const u8& byte) {
            sum = (sum + u32(byte)) % 65521;
            weighted_sum = (weighted_sum + sum) % 65521;
        });
    return weighted_sum * 65536 + sum;
}

u32 record_checksum(const Vec<u8>& payload)
{
    return record_checksum_range(payload, 0, payload.len());
}

Vec<u8> make_data_record(u32 version, const Vec<u8>& key, const Vec<u8>& value) throws stainless::IoError
{
    Vec<u8> payload;
    payload.push(RecordKind::Insert);
    BigEndian::write_u32(payload, version);
    BigEndian::write_u64(payload, key.len());
    BigEndian::write_u32(payload, value.len());
    payload.extend_from_slice(key);
    payload.extend_from_slice(value);

    u32 checksum = record_checksum(payload);
    Vec<u8> record;
    BigEndian::write_u32(record, payload.len() + 8);
    record.append(payload);
    BigEndian::write_u32(record, checksum);
    return record;
}

StoreState initial_state()
{
    StoreState state = StoreState{
        Map<tuple<Vec<u8>, u32>, IndexEntry>(),
        Map<u32, u64>(),
        0,
        0,
        0
    };
    state.version_index.insert(0, 0);
    return state;
}

String make_index_path(const String& path)
{
    String result = path.clone();
    result.push_str(".index");
    return result;
}

File open_log(const String& path) throws stainless::IoError
{
    OpenOptions options;
    options.read(true);
    options.write(true);
    options.create(true);
    return options.open(path);
}

u8 decode_u8_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u8_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u8 field")};
    }
}

u32 decode_u32_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u32_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u32 field")};
    }
}

u64 decode_u64_at(const Vec<u8>& bytes, usize offset) throws IndexCorrupt
{
    try {
        return BigEndian::read_u64_at(bytes, offset);
    } catch (const stainless::IoError& _error) {
        throw IndexCorrupt{stainless::Exception("invalid index WAL u64 field")};
    }
}

RecordKind index_record_kind(const Vec<u8>& record) throws IndexCorrupt
{
    try {
        return RecordKind(decode_u8_at(record, 4));
    } catch (const stainless::EnumError& _error) {
        throw IndexCorrupt{stainless::Exception("unknown index WAL record kind")};
    }
}

Vec<u8> read_index_record_at(
    const File& index_log,
    u64 start,
    u64 file_len) throws IndexCorrupt, stainless::IoError
{
    if (start > file_len || file_len - start < 4) {
        throw IndexCorrupt{
            stainless::Exception("truncated index WAL record header")
        };
    }
    u32 record_size = decode_u32_at(index_log.pread_exact(start, 4), 0);
    if (record_size < 21 || u64(record_size) > file_len - start) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL record size")
        };
    }
    Vec<u8> record = index_log.pread_exact(start, usize(record_size));
    if (decode_u32_at(record, 0) != record_size) {
        throw IndexCorrupt{
            stainless::Exception("invalid index WAL record framing")
        };
    }
    usize checksum_offset = record.len() - 4;
    u32 expected_checksum = decode_u32_at(record, checksum_offset);
    if (record_checksum_range(record, 4, checksum_offset) != expected_checksum) {
        throw IndexCorrupt{
            stainless::Exception("index WAL checksum mismatch")
        };
    }
    return record;
}

Vec<KeyValue> read_key_values(
    const File& data_log,
    const Vec<tuple<Vec<u8>, IndexEntry>>& entries) throws stainless::IoError
{
    Vec<KeyValue> values;
    for (const auto& entry : entries) {
        values.push(KeyValue{
            entry.0.clone(),
            data_log.pread_exact(entry.1.offset, usize(entry.1.length))
        });
    }
    return values;
}

} // namespace detail

} // namespace kvstore
