    }
    return DecodedAt<u16>{true, next, value};
}

KeyCodec<u16> u16_key()
{
    return KeyCodec<u16>{
        [](const u16& value) {
            return encode_u16(value);
        },
        [](const Vec<u8>& bytes, usize offset) {
            return decode_u16_at(bytes, offset);
        }
    };
}

