// Append-only, versioned key/value storage implemented entirely in Stainless.
//
// Values and their compact index records live in separate append-only files.
// Writes are tagged with the current version. commit(next) syncs the data file
// before appending the durable index commit marker. An in-memory version index
// maps versions to index-WAL commit offsets, so revert(version) seeks directly
// to the selected boundary and reads the discarded suffix sequentially.

use rust::{Map, String, Vec};
use rust::std::fs;
use rust::std::fs::{File, OpenOptions};
use rust::std::thread;
use stainless::BigEndian;

namespace kvstore {

struct Value {
    Vec<u8> bytes;
};

struct IndexEntry {
    u64 offset;
    u32 length;
};

struct PendingIndexEntry {
    Vec<u8> key;
    u32 version;
    optional<IndexEntry> previous;
};

struct KeyValue {
    Vec<u8> key;
    Vec<u8> value;
};

struct Encoded {
    bool valid;
    Vec<u8> bytes;
};

struct Decoded<T> {
    bool valid;
    T value;
};

struct DecodedAt<T> {
    bool valid;
    usize offset;
    T value;
};

struct KeyCodec<T> {
    function<Encoded(const T&)> encode;
    function<DecodedAt<T>(const Vec<u8>&, usize)> decode;

    KeyCodec<Vec<T>> vec() const;
};

enum RecordKind : u8 {
    Insert = 0,
    Commit = 1,
};

struct ValueTooLarge : stainless::Exception {
};

struct IndexCorrupt : stainless::Exception {
};

struct CodecError : stainless::Exception {
};

struct Limits {
    static const usize MaxValueLength = 4294967295;
    static const u32 MaxVersion = 4294967295;
};

struct StoreState {
    Map<tuple<Vec<u8>, u32>, IndexEntry> index;
    Map<u32, u64> version_index;
    u32 current_version;
    u64 data_len;
    u64 index_len;
};

class RawTable {
    RawTable(const String& path) throws stainless::IoError;

    void recover() const throws stainless::IoError;
    void insert(Vec<u8> key, Vec<u8> value) const throws ValueTooLarge, stainless::IoError;
    bool commit(u32 next_version) const throws stainless::IoError;
    bool revert(u32 version) const throws IndexCorrupt, stainless::IoError;

    u32 current_version() const;

    shared_nullptr<Value> find(const Vec<u8>& key) const throws stainless::IoError;

    Vec<KeyValue> find_range(
        const Vec<u8>& lower, const Vec<u8>& upper) const throws stainless::IoError;
    Vec<KeyValue> find_range_first(
        const Vec<u8>& lower, const Vec<u8>& upper, usize count) const throws stainless::IoError;
    Vec<KeyValue> find_range_last(
        const Vec<u8>& lower, const Vec<u8>& upper, usize count) const throws stainless::IoError;

private:
    File data_log;
    File index_log;
    shared_mutex<StoreState> state;
};

struct DatabaseState {
    Vec<shared_ptr<RawTable>> tables;
};

class Database {
    Database();

    void add(shared_ptr<RawTable> table) const;
    bool commit(u32 next_version) const throws stainless::IoError;
    bool revert(u32 version) const throws IndexCorrupt, stainless::IoError;
    u32 recover() const throws IndexCorrupt, stainless::IoError;

    u32 current_version() const;

private:
    mutex<DatabaseState> state;
};

class Table<K, V> : public RawTable {
    Table(
        const String& path,
        function<Encoded(const K&)> encode_key,
        function<Decoded<K>(const Vec<u8>&)> decode_key,
        function<Encoded(const V&)> encode_value,
        function<Decoded<V>(const Vec<u8>&)> decode_value) throws stainless::IoError;

    void insert(K key, V value) const throws CodecError, ValueTooLarge, stainless::IoError;

    bool find(const K& key, V& value) const throws CodecError, stainless::IoError;

    Vec<tuple<K, V>> find_range(const K& lower, const K& upper) const
        throws CodecError, stainless::IoError;
    Vec<tuple<K, V>> find_range_first(const K& lower, const K& upper, usize count) const
        throws CodecError, stainless::IoError;
    Vec<tuple<K, V>> find_range_last(const K& lower, const K& upper, usize count) const
        throws CodecError, stainless::IoError;
    
private:
    function<Encoded(const K&)> encode_key;
    function<Decoded<K>(const Vec<u8>&)> decode_key;
    function<Encoded(const V&)> encode_value;
    function<Decoded<V>(const Vec<u8>&)> decode_value;
};

class JsonTable<K> : public Table<K, var> {
    JsonTable(
        const String& path,
        function<Encoded(const K&)> encode_key,
        function<Decoded<K>(const Vec<u8>&)> decode_key) throws stainless::IoError;

};

class JsonTable1<K> : public JsonTable<K> {
    JsonTable1(const String& path, KeyCodec<K> key_codec) throws stainless::IoError;
};

class JsonTable2<K1, K2> : public JsonTable<tuple<K1, K2>> {
    JsonTable2(
        const String& path,
        KeyCodec<K1> first_codec,
        KeyCodec<K2> second_codec) throws stainless::IoError;

    void insert(K1 first, K2 second, var value) const
        throws CodecError, ValueTooLarge, stainless::IoError;
    bool find(K1 first, K2 second, var& value) const
        throws CodecError, stainless::IoError;
};

class JsonTable3<K1, K2, K3> : public JsonTable<tuple<K1, K2, K3>> {
    JsonTable3(
        const String& path,
        KeyCodec<K1> first_codec,
        KeyCodec<K2> second_codec,
        KeyCodec<K3> third_codec) throws stainless::IoError;

    void insert(K1 first, K2 second, K3 third, var value) const
        throws CodecError, ValueTooLarge, stainless::IoError;
    bool find(K1 first, K2 second, K3 third, var& value) const
        throws CodecError, stainless::IoError;
};

KeyCodec<Vec<T>> KeyCodec<T>::vec() const
{
    return KeyCodec<Vec<T>>{
        [encode_element = encode](const Vec<T>& values) {
            Vec<u8> bytes;
            for (const auto& value : values) {
                Encoded element = encode_element(value);
                if (!element.valid) {
                    return Encoded{false, Vec<u8>()};
                }
                for (const u8& byte : element.bytes) {
                    if (byte == 0) {
                        bytes.push(0);
                        bytes.push(255);
                    } else {
                        bytes.push(byte);
                    }
                }
                bytes.push(0);
                bytes.push(1);
            }
            bytes.push(0);
            bytes.push(0);
            return Encoded{true, move(bytes)};
        },
        [decode_element = decode](const Vec<u8>& bytes, usize offset) {
            usize position = 0;
            usize next = offset;
            bool escaped = false;
            bool finished = false;
            bool valid = true;
            Vec<T> values;
            Vec<u8> element_bytes;
            for (const u8& byte : bytes) {
                if (position >= offset && !finished && valid) {
                    next = position + 1;
                    if (!escaped) {
                        if (byte == 0) {
                            escaped = true;
                        } else {
                            element_bytes.push(byte);
                        }
                    } else {
                        escaped = false;
                        if (byte == 255) {
                            element_bytes.push(0);
                        } else if (byte == 1) {
                            DecodedAt<T> element = decode_element(element_bytes, 0);
                            if (!element.valid || element.offset != element_bytes.len()) {
                                valid = false;
                            } else {
                                values.push(move(element.value));
                                element_bytes.clear();
                            }
                        } else if (byte == 0 && element_bytes.empty()) {
                            finished = true;
                        } else {
                            valid = false;
                        }
                    }
                }
                position += 1;
            }
            if (valid && finished) {
                return DecodedAt<Vec<T>>{true, next, move(values)};
            }
            return DecodedAt<Vec<T>>{false, offset, Vec<T>()};
        }
    };
}

RawTable::RawTable(const String& path)
    : data_log(detail::open_log(path)),
      index_log(detail::open_log(detail::make_index_path(path))),
      state(detail::initial_state())
{
    this.recover();
}

void RawTable::insert(Vec<u8> key, Vec<u8> value) const
{
    if (value.len() > Limits::MaxValueLength) {
        throw ValueTooLarge{
            stainless::Exception("encoded value exceeds the u32 length limit")
        };
    }
    auto guard = state.write();
    u32 version = guard.current_version;
    Vec<u8> data_record = detail::make_data_record(version, key, value);
    u64 offset = guard.data_len + 21 + u64(key.len());
    u64 data_len = guard.data_len + u64(data_record.len());
    detail::InsertRecord insert = detail::InsertRecord{
        version,
        offset,
        u32(value.len()),
        move(key)
    };
    Vec<u8> index_record = insert.write();
    data_log.pwrite_all(guard.data_len, data_record);
    index_log.pwrite_all(guard.index_len, index_record);
    guard.data_len = data_len;
    guard.index_len += u64(index_record.len());
    guard.index.insert(
        tuple<Vec<u8>, u32>(move(insert.key), insert.version),
        IndexEntry{insert.offset, insert.length});
}

bool RawTable::commit(u32 next_version) const
{
    auto guard = state.write();
    if (next_version < guard.current_version) {
        return false;
    }
    detail::CommitRecord commit = detail::CommitRecord{
        next_version,
        guard.data_len
    };
    Vec<u8> record = commit.write();
    u64 version_offset = guard.index_len;
    data_log.set_len(guard.data_len);
    data_log.sync_data();
    index_log.set_len(guard.index_len);
    index_log.pwrite_all(guard.index_len, record);
    guard.index_len += u64(record.len());
    index_log.set_len(guard.index_len);
    index_log.sync_data();
    guard.version_index.insert(next_version, version_offset);
    guard.current_version = next_version;
    return true;
}

bool RawTable::revert(u32 version) const
{
    auto guard = state.write();
    if (version > guard.current_version) {
        return false;
    }
    u64 marker_offset = 0;
    bool exact_version = guard.version_index.with(
        version,
        [&marker_offset](const u64& offset) {
            marker_offset = offset;
        });
    u64 boundary = 0;
    u64 data_len = 0;
    if (!exact_version) {
        bool found_successor = guard.version_index.with_first_in_range(
            version,
            Limits::MaxVersion,
            [&marker_offset](const u32& _indexed_version, const u64& offset) {
                marker_offset = offset;
            });
        if (!found_successor) {
            throw IndexCorrupt{
                stainless::Exception("missing successor version offset")
            };
        }
    }
    if (version != 0 || !exact_version) {
        Vec<u8> marker_bytes = detail::read_index_record_at(index_log, marker_offset, guard.index_len);
        detail::CommitRecord marker = detail::CommitRecord::read(marker_bytes);
        if ((exact_version && marker.version != version) || (!exact_version && marker.version <= version)) {
            throw IndexCorrupt{
                stainless::Exception("invalid indexed commit marker")
            };
        }
        boundary = marker_offset;
        if (exact_version) {
            boundary += u64(marker_bytes.len());
        }
        data_len = marker.data_len;
    }

    Vec<tuple<Vec<u8>, u32>> removed;
    Vec<u32> removed_versions;
    for (u64 scan_offset = boundary; scan_offset < guard.index_len;) {
        Vec<u8> record = detail::read_index_record_at(
            index_log,
            scan_offset,
            guard.index_len);
        RecordKind kind = detail::index_record_kind(record);
        if (kind == RecordKind::Insert) {
            detail::InsertRecord insert = detail::InsertRecord::read(record);
            removed.push(tuple<Vec<u8>, u32>(
                move(insert.key),
                insert.version));
        } else if (kind == RecordKind::Commit) {
            detail::CommitRecord commit = detail::CommitRecord::read(record);
            removed_versions.push(commit.version);
        } else {
            throw IndexCorrupt{
                stainless::Exception("unknown index WAL record kind")
            };
        }
        scan_offset += u64(record.len());
    }

    index_log.set_len(boundary);
    u64 new_index_len = boundary;
    if (!exact_version) {
        detail::CommitRecord commit = detail::CommitRecord{version, data_len};
        Vec<u8> marker = commit.write();
        index_log.pwrite_all(boundary, marker);
        new_index_len += u64(marker.len());
        index_log.set_len(new_index_len);
    }
    index_log.sync_data();

    for (const auto& index_key : removed) {
        guard.index.remove(index_key);
    }
    for (auto removed_version : removed_versions) {
        guard.version_index.remove(removed_version);
    }
    if (!exact_version) {
        guard.version_index.insert(version, boundary);
    }
    guard.current_version = version;
    guard.data_len = data_len;
    guard.index_len = new_index_len;
    data_log.set_len(data_len);
    data_log.sync_data();
    return true;
}

u32 RawTable::current_version() const
{
    auto guard = state.read();
    return guard.current_version;
}

shared_nullptr<Value> RawTable::find(const Vec<u8>& key) const
{
    auto guard = state.read();
    bool found = false;
    u64 best_offset = 0;
    u32 best_length = 0;
    u32 current_version = guard.current_version;

    tuple<Vec<u8>, u32> lower = tuple<Vec<u8>, u32>(key.clone(), 0);
    tuple<Vec<u8>, u32> upper = tuple<Vec<u8>, u32>(
        key.clone(),
        current_version);
    guard.index.with_last_in_range(
        lower,
        upper,
        [&found,
         &best_offset,
         &best_length](
            const tuple<Vec<u8>, u32>& _index_key,
            const IndexEntry& location) {
            found = true;
            best_offset = location.offset;
            best_length = location.length;
        });
    if (!found) {
        return nullptr;
    }
    return shared_nullptr<Value>(
        make_shared<Value>{data_log.pread_exact(best_offset, usize(best_length))});
}

Vec<KeyValue> RawTable::find_range(const Vec<u8>& lower, const Vec<u8>& upper) const
{
    auto guard = state.read();
    u32 current_version = guard.current_version;
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool has_candidate = false;
    Vec<u8> candidate_key;
    IndexEntry candidate_location = IndexEntry{0, 0};

    guard.index.with_range(
        index_lower,
        index_upper,
        [&entries,
         &has_candidate,
         &candidate_key,
         &candidate_location](
            const tuple<Vec<u8>, u32>& index_key,
            const IndexEntry& location) {
            if (!has_candidate || candidate_key != index_key.0) {
                if (has_candidate) {
                    entries.push(tuple<Vec<u8>, IndexEntry>(
                        candidate_key.clone(),
                        candidate_location));
                }
                candidate_key = index_key.0.clone();
                has_candidate = true;
            }
            candidate_location = location;
        });
    if (has_candidate) {
        entries.push(tuple<Vec<u8>, IndexEntry>(
            move(candidate_key),
            candidate_location));
    }
    return detail::read_key_values(data_log, entries);
}

Vec<KeyValue> RawTable::find_range_last(
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) const
{
    auto guard = state.read();
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), guard.current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool include_upper = true;

    for (; entries.len() < count;) {
        bool found = false;
        Vec<u8> key;
        IndexEntry location = IndexEntry{0, 0};
        if (include_upper) {
            found = guard.index.with_last_in_range(
                index_lower,
                index_upper,
                [&key, &location](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& selected) {
                    key = index_key.0.clone();
                    location = selected;
                });
            include_upper = false;
        } else {
            found = guard.index.with_last_before(
                index_lower,
                index_upper,
                [&key, &location](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& selected) {
                    key = index_key.0.clone();
                    location = selected;
                });
        }
        if (!found) {
            break;
        }
        entries.push(tuple<Vec<u8>, IndexEntry>(key.clone(), location));
        index_upper = tuple<Vec<u8>, u32>(move(key), 0);
    }
    return detail::read_key_values(data_log, entries);
}

Vec<KeyValue> RawTable::find_range_first(
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) const
{
    auto guard = state.read();
    u32 current_version = guard.current_version;
    tuple<Vec<u8>, u32> index_lower = tuple<Vec<u8>, u32>(lower.clone(), 0);
    tuple<Vec<u8>, u32> index_upper = tuple<Vec<u8>, u32>(upper.clone(), current_version);
    Vec<tuple<Vec<u8>, IndexEntry>> entries;
    bool include_lower = true;

    for (; entries.len() < count;) {
        bool found = false;
        Vec<u8> key;
        if (include_lower) {
            found = guard.index.with_first_in_range(
                index_lower,
                index_upper,
                [&key](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& _selected) {
                    key = index_key.0.clone();
                });
            include_lower = false;
        } else {
            found = guard.index.with_first_after(
                index_lower,
                index_upper,
                [&key](
                    const tuple<Vec<u8>, u32>& index_key,
                    const IndexEntry& _selected) {
                    key = index_key.0.clone();
                });
        }
        if (!found) {
            break;
        }

        IndexEntry location = IndexEntry{0, 0};
        tuple<Vec<u8>, u32> key_lower = tuple<Vec<u8>, u32>(key.clone(), 0);
        tuple<Vec<u8>, u32> key_upper = tuple<Vec<u8>, u32>(key.clone(), current_version);
        found = guard.index.with_last_in_range(
            key_lower,
            key_upper,
            [&location](
                const tuple<Vec<u8>, u32>& _index_key,
                const IndexEntry& selected) {
                location = selected;
            });
        if (!found) {
            break;
        }
        entries.push(tuple<Vec<u8>, IndexEntry>(key.clone(), location));
        index_lower = tuple<Vec<u8>, u32>(move(key), current_version);
    }
    return detail::read_key_values(data_log, entries);
}

shared_ptr<RawTable> open_table(const String& path) throws stainless::IoError
{
    return make_shared<RawTable>(path);
}

void RawTable::recover() const
{
    auto guard = state.write();
    u64 data_file_len = data_log.len();
    u64 index_file_len = index_log.len();
    u64 offset = 0;
    u64 committed_index_len = 0;
    u64 committed_data_len = 0;
    u32 committed_version = 0;
    Map<tuple<Vec<u8>, u32>, IndexEntry> working;
    Map<u32, u64> recovered_version_index;
    recovered_version_index.insert(0, 0);
    Vec<PendingIndexEntry> pending;

    for (; offset < index_file_len;) {
        try {
            Vec<u8> record = detail::read_index_record_at(
                index_log,
                offset,
                index_file_len);
            u64 next_offset = offset + u64(record.len());
            RecordKind kind = detail::index_record_kind(record);
            if (kind == RecordKind::Insert) {
                detail::InsertRecord insert = detail::InsertRecord::read(record);
                if (insert.offset > data_file_len ||
                    u64(insert.length) > data_file_len - insert.offset) {
                    break;
                }
                IndexEntry previous;
                tuple<Vec<u8>, u32> index_key = tuple<Vec<u8>, u32>(insert.key.clone(), insert.version);
                bool had_previous = working.with(index_key, [&previous](const IndexEntry& entry) {
                    previous = entry;
                });
                optional<IndexEntry> previous_value;
                if (had_previous) {
                    previous_value = optional<IndexEntry>(previous);
                }
                pending.push(PendingIndexEntry{insert.key.clone(), insert.version, move(previous_value)});
                working.insert(
                    tuple<Vec<u8>, u32>(move(insert.key), insert.version),
                    IndexEntry{insert.offset, insert.length});
            } else if (kind == RecordKind::Commit) {
                detail::CommitRecord commit = detail::CommitRecord::read(record);
                if (commit.data_len > data_file_len) {
                    break;
                }
                pending.clear();
                recovered_version_index.insert(commit.version, offset);
                committed_version = commit.version;
                committed_data_len = commit.data_len;
                committed_index_len = next_offset;
            } else {
                break;
            }
            offset = next_offset;
        } catch (const IndexCorrupt& _error) {
            break;
        }
    }

    for (usize count = pending.len(); count > 0;) {
        count -= 1;
        PendingIndexEntry entry = pending[count];
        tuple<Vec<u8>, u32> index_key = tuple<Vec<u8>, u32>(move(entry.key), entry.version);
        if (entry.previous.has_value()) {
            working.insert(move(index_key), entry.previous.value_or(IndexEntry{0, 0}));
        } else {
            working.remove(index_key);
        }
    }
    if (index_file_len != committed_index_len) {
        index_log.set_len(committed_index_len);
        index_log.sync_data();
    }
    if (data_file_len != committed_data_len) {
        data_log.set_len(committed_data_len);
        data_log.sync_data();
    }
    guard.index = move(working);
    guard.version_index = move(recovered_version_index);
    guard.current_version = committed_version;
    guard.data_len = committed_data_len;
    guard.index_len = committed_index_len;
}

Database::Database()
    : state(DatabaseState{Vec<shared_ptr<RawTable>>()})
{
}

void Database::add(shared_ptr<RawTable> table) const
{
    auto guard = state.lock();
    guard.tables.push(table);
}

bool Database::commit(u32 next_version) const
{
    auto guard = state.lock();
    if (guard.tables.empty()) {
        return false;
    }
    u32 current_version = 0;
    bool first = true;
    for (auto table : guard.tables) {
        u32 table_version = table.current_version();
        if (first) {
            current_version = table_version;
            first = false;
        } else if (table_version != current_version) {
            return false;
        }
    }
    if (next_version <= current_version) {
        return false;
    }
    for (auto table : guard.tables) {
        if (!table.commit(next_version)) {
            return false;
        }
    }
    return true;
}

bool Database::revert(u32 version) const
{
    auto guard = state.lock();
    if (guard.tables.empty()) {
        return false;
    }
    for (auto table : guard.tables) {
        if (version > table.current_version()) {
            return false;
        }
    }
    for (auto table : guard.tables) {
        if (!table.revert(version)) {
            return false;
        }
    }
    return true;
}

u32 Database::current_version() const
{
    auto guard = state.lock();
    if (guard.tables.empty()) {
        return 0;
    }
    u32 version = Limits::MaxVersion;
    for (auto table : guard.tables) {
        u32 table_version = table.current_version();
        if (table_version < version) {
            version = table_version;
        }
    }
    return version;
}

u32 Database::recover() const
{
    auto guard = state.lock();
    if (guard.tables.empty()) {
        return 0;
    }
    u32 version = Limits::MaxVersion;
    for (auto table : guard.tables) {
        u32 table_version = table.current_version();
        if (table_version < version) {
            version = table_version;
        }
    }
    for (auto table : guard.tables) {
        if (table.current_version() > version) {
            table.revert(version);
        }
    }
    return version;
}

Table<K, V>::Table(
    const String& path,
    function<Encoded(const K&)> encode_key,
    function<Decoded<K>(const Vec<u8>&)> decode_key,
    function<Encoded(const V&)> encode_value,
    function<Decoded<V>(const Vec<u8>&)> decode_value)
    : RawTable(path),
      encode_key(encode_key),
      decode_key(decode_key),
      encode_value(encode_value),
      decode_value(decode_value)
{
}

void Table<K, V>::insert(K key, V value) const
{
    Encoded key_bytes = encode_key(key);
    if (!key_bytes.valid) {
        throw CodecError{stainless::Exception("key encoding failed")};
    }
    Encoded value_bytes = encode_value(value);
    if (!value_bytes.valid) {
        throw CodecError{stainless::Exception("value encoding failed")};
    }
    RawTable::insert(move(key_bytes.bytes), move(value_bytes.bytes));
}

bool Table<K, V>::find(const K& key, V& value) const
{
    Encoded key_bytes = encode_key(key);
    if (!key_bytes.valid) {
        throw CodecError{stainless::Exception("key encoding failed")};
    }
    shared_nullptr<Value> stored = RawTable::find(key_bytes.bytes);
    if (!stored) {
        return false;
    }
    shared_ptr<Value> present = shared_ptr<Value>(stored);
    Decoded<V> decoded = decode_value(present.bytes);
    if (!decoded.valid) {
        throw CodecError{stainless::Exception("value decoding failed")};
    }
    value = move(decoded.value);
    return true;
}

Vec<tuple<K, V>> Table<K, V>::find_range(const K& lower, const K& upper) const
{
    Encoded lower_bytes = encode_key(lower);
    Encoded upper_bytes = encode_key(upper);
    if (!lower_bytes.valid || !upper_bytes.valid) {
        throw CodecError{stainless::Exception("range key encoding failed")};
    }
    Vec<KeyValue> entries = RawTable::find_range(lower_bytes.bytes, upper_bytes.bytes);
    Vec<tuple<K, V>> result;
    for (const auto& entry : entries) {
        Decoded<K> decoded_key = decode_key(entry.key);
        Decoded<V> decoded_value = decode_value(entry.value);
        if (!decoded_key.valid || !decoded_value.valid) {
            throw CodecError{stainless::Exception("range decoding failed")};
        }
        result.push(tuple<K, V>(move(decoded_key.value), move(decoded_value.value)));
    }
    return result;
}

Vec<tuple<K, V>> Table<K, V>::find_range_first(
    const K& lower,
    const K& upper,
    usize count) const
{
    Encoded lower_bytes = encode_key(lower);
    Encoded upper_bytes = encode_key(upper);
    if (!lower_bytes.valid || !upper_bytes.valid) {
        throw CodecError{stainless::Exception("range key encoding failed")};
    }
    Vec<KeyValue> entries = RawTable::find_range_first(
        lower_bytes.bytes,
        upper_bytes.bytes,
        count);
    Vec<tuple<K, V>> result;
    for (const auto& entry : entries) {
        Decoded<K> decoded_key = decode_key(entry.key);
        Decoded<V> decoded_value = decode_value(entry.value);
        if (!decoded_key.valid || !decoded_value.valid) {
            throw CodecError{stainless::Exception("range decoding failed")};
        }
        result.push(tuple<K, V>(move(decoded_key.value), move(decoded_value.value)));
    }
    return result;
}

Vec<tuple<K, V>> Table<K, V>::find_range_last(
    const K& lower,
    const K& upper,
    usize count) const
{
    Encoded lower_bytes = encode_key(lower);
    Encoded upper_bytes = encode_key(upper);
    if (!lower_bytes.valid || !upper_bytes.valid) {
        throw CodecError{stainless::Exception("range key encoding failed")};
    }
    Vec<KeyValue> entries = RawTable::find_range_last(
        lower_bytes.bytes,
        upper_bytes.bytes,
        count);
    Vec<tuple<K, V>> result;
    for (const auto& entry : entries) {
        Decoded<K> decoded_key = decode_key(entry.key);
        Decoded<V> decoded_value = decode_value(entry.value);
        if (!decoded_key.valid || !decoded_value.valid) {
            throw CodecError{stainless::Exception("range decoding failed")};
        }
        result.push(tuple<K, V>(move(decoded_key.value), move(decoded_value.value)));
    }
    return result;
}

JsonTable<K>::JsonTable(
    const String& path,
    function<Encoded(const K&)> encode_key,
    function<Decoded<K>(const Vec<u8>&)> decode_key)
    : Table<K, var>(path, encode_key, decode_key, codecs::encode_json, codecs::decode_json)
{
}

JsonTable1<K>::JsonTable1(const String& path, KeyCodec<K> key_codec)
    : JsonTable(
          path,
          key_codec.encode,
          [decode = key_codec.decode](const Vec<u8>& bytes) {
              DecodedAt<K> decoded = decode(bytes, 0);
              return Decoded<K>{
                  decoded.valid && decoded.offset == bytes.len(),
                  move(decoded.value)
              };
          })
{
}

JsonTable2<K1, K2>::JsonTable2(
    const String& path,
    KeyCodec<K1> first_codec,
    KeyCodec<K2> second_codec)
    : JsonTable(
          path,
          [encode_first = first_codec.encode,
           encode_second = second_codec.encode](const tuple<K1, K2>& key) {
              Encoded first = encode_first(key.0);
              Encoded second = encode_second(key.1);
              if (!first.valid || !second.valid) {
                  return Encoded{false, Vec<u8>()};
              }
              first.bytes.append(second.bytes);
              return Encoded{true, move(first.bytes)};
          },
          [decode_first = first_codec.decode,
           decode_second = second_codec.decode](const Vec<u8>& bytes) {
              DecodedAt<K1> first = decode_first(bytes, 0);
              DecodedAt<K2> second = decode_second(bytes, first.offset);
              return Decoded<tuple<K1, K2>>{
                  first.valid && second.valid && second.offset == bytes.len(),
                  tuple<K1, K2>(move(first.value), move(second.value))
              };
          })
{
}

void JsonTable2<K1, K2>::insert(K1 first, K2 second, var value) const
{
    JsonTable::insert(
        tuple<K1, K2>(move(first), move(second)),
        move(value));
}

bool JsonTable2<K1, K2>::find(K1 first, K2 second, var& value) const
{
    tuple<K1, K2> key = tuple<K1, K2>(move(first), move(second));
    return JsonTable::find(key, value);
}

JsonTable3<K1, K2, K3>::JsonTable3(
    const String& path,
    KeyCodec<K1> first_codec,
    KeyCodec<K2> second_codec,
    KeyCodec<K3> third_codec)
    : JsonTable(
          path,
          [encode_first = first_codec.encode,
           encode_second = second_codec.encode,
           encode_third = third_codec.encode](const tuple<K1, K2, K3>& key) {
              Encoded first = encode_first(key.0);
              Encoded second = encode_second(key.1);
              Encoded third = encode_third(key.2);
              if (!first.valid || !second.valid || !third.valid) {
                  return Encoded{false, Vec<u8>()};
              }
              first.bytes.append(second.bytes);
              first.bytes.append(third.bytes);
              return Encoded{true, move(first.bytes)};
          },
          [decode_first = first_codec.decode,
           decode_second = second_codec.decode,
           decode_third = third_codec.decode](const Vec<u8>& bytes) {
              DecodedAt<K1> first = decode_first(bytes, 0);
              DecodedAt<K2> second = decode_second(bytes, first.offset);
              DecodedAt<K3> third = decode_third(bytes, second.offset);
              return Decoded<tuple<K1, K2, K3>>{
                  first.valid && second.valid && third.valid && third.offset == bytes.len(),
                  tuple<K1, K2, K3>(move(first.value), move(second.value), move(third.value))
              };
          })
{
}

void JsonTable3<K1, K2, K3>::insert(K1 first, K2 second, K3 third, var value) const
{
    JsonTable::insert(
        tuple<K1, K2, K3>(move(first), move(second), move(third)),
        move(value));
}

bool JsonTable3<K1, K2, K3>::find(
    K1 first,
    K2 second,
    K3 third,
    var& value) const
{
    tuple<K1, K2, K3> key = tuple<K1, K2, K3>(
        move(first),
        move(second),
        move(third));
    return JsonTable::find(key, value);
}

void insert_bytes(shared_ptr<RawTable> table, Vec<u8> key, Vec<u8> value)
    throws ValueTooLarge, stainless::IoError
{
    table.insert(move(key), move(value));
}

shared_nullptr<Value> find_bytes(shared_ptr<RawTable> table, const Vec<u8>& key) throws stainless::IoError
{
    return table.find(key);
}

Vec<KeyValue> find_range_bytes(
    shared_ptr<RawTable> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper) throws stainless::IoError
{
    return table.find_range(lower, upper);
}

Vec<KeyValue> find_range_last_bytes(
    shared_ptr<RawTable> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) throws stainless::IoError
{
    return table.find_range_last(lower, upper, count);
}

Vec<KeyValue> find_range_first_bytes(
    shared_ptr<RawTable> table,
    const Vec<u8>& lower,
    const Vec<u8>& upper,
    usize count) throws stainless::IoError
{
    return table.find_range_first(lower, upper, count);
}

bool commit_table(shared_ptr<RawTable> table, u32 version) throws stainless::IoError
{
    return table.commit(version);
}

bool revert_table(shared_ptr<RawTable> table, u32 version) throws IndexCorrupt, stainless::IoError
{
    return table.revert(version);
}

u32 table_version(shared_ptr<RawTable> table)
{
    return table.current_version();
}

namespace codecs {

Encoded encode_json(const var& value)
{
    return Encoded{true, value.to_json().into_bytes()};
}

Decoded<var> decode_json(const Vec<u8>& bytes)
{
    try {
        return Decoded<var>{true, var::parse_bytes(bytes)};
    } catch (const stainless::JsonError& _error) {
        return Decoded<var>{false, var()};
    }
}

Encoded encode_u8(const u8& value)
{
    Vec<u8> bytes;
    BigEndian::write(bytes, value);
    return Encoded{true, move(bytes)};
}

Decoded<u8> decode_u8(const Vec<u8>& bytes)
{
    DecodedAt<u8> decoded = decode_u8_at(bytes, 0);
    return Decoded<u8>{
        decoded.valid && decoded.offset == bytes.len(),
        decoded.value
    };
}

DecodedAt<u8> decode_u8_at(const Vec<u8>& bytes, usize offset)
{
    usize next = offset;
    u8 value = 0;
    try {
        BigEndian::read(bytes, next, value);
    } catch (const stainless::IoError& _error) {
        return DecodedAt<u8>{false, offset, 0};
    }
    return DecodedAt<u8>{true, next, value};
}

KeyCodec<u8> u8_key()
{
    return KeyCodec<u8>{
        [](const u8& value) {
            return encode_u8(value);
        },
        [](const Vec<u8>& bytes, usize offset) {
            return decode_u8_at(bytes, offset);
        }
    };
}

KeyCodec<String> string_key()
{
    return KeyCodec<String>{
        [](const String& value) {
            String copy = value.clone();
            Vec<u8> utf8 = move(copy).into_bytes();
            Vec<u8> bytes;
            for (const u8& byte : utf8) {
                if (byte == 0) {
                    bytes.push(0);
                    bytes.push(255);
                } else {
                    bytes.push(byte);
                }
            }
            bytes.push(0);
            bytes.push(0);
            return Encoded{true, move(bytes)};
        },
        [](const Vec<u8>& bytes, usize offset) {
            usize position = 0;
            usize next = offset;
            bool escaped = false;
            bool finished = false;
            bool valid = true;
            Vec<u8> utf8;
            for (const u8& byte : bytes) {
                if (position >= offset && !finished && valid) {
                    next = position + 1;
                    if (!escaped) {
                        if (byte == 0) {
                            escaped = true;
                        } else {
                            utf8.push(byte);
                        }
                    } else {
                        escaped = false;
                        if (byte == 255) {
                            utf8.push(0);
                        } else if (byte == 0) {
                            finished = true;
                        } else {
                            valid = false;
                        }
                    }
                }
                position += 1;
            }
            if (valid && finished) {
                try {
                    String value = String::from_utf8(move(utf8));
                    return DecodedAt<String>{true, next, move(value)};
                } catch (const stainless::RustError& _error) {
                }
            }
            return DecodedAt<String>{false, offset, String()};
        }
    };
}

Encoded encode_u16(const u16& value)
{
    Vec<u8> bytes;
    BigEndian::write(bytes, value);
    return Encoded{true, move(bytes)};
}

Decoded<u16> decode_u16(const Vec<u8>& bytes)
