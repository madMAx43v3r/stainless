// Consensus-facing poker2.js message hashes. Keep these byte-for-byte aligned
// with the contract implementation in mmx-node.

use rust::{String, Vec};

namespace poker {
namespace protocol {

String decimal_u64(const u64 value)
{
    return crypto::uint_decimal(u128(value));
}

String decimal_u128(const u128& value)
{
    return crypto::uint_decimal(value);
}

void append_segment(String& message, const String& value)
{
    message.push_str("/");
    message.push_str(value);
}

bool valid_hash(const String& value)
{
    return crypto::is_hex(value, 32);
}

String seed_commit(const String& table, const u64 hand_id, const String& address,
                   const u64 seed_round, const String& seed)
{
    if (seed_round >= 5 || !valid_hash(seed)) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_SEED_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, address);
    append_segment(message, decimal_u64(seed_round));
    append_segment(message, seed);
    return crypto::sha256::hash(message);
}

String commit_hash(const String& table, const u64 hand_id, const String& address,
                   const Vec<String>& commitments)
{
    if (commitments.len() != 5) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_COMMIT_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, address);
    for (const String& commitment : commitments) {
        if (!valid_hash(commitment)) {
            return "";
        }
        append_segment(message, commitment);
    }
    return crypto::sha256::hash(message);
}

String action_hash(const String& table, const u64 hand_id, const String& address, const u64 betting_round,
                   const u64 epoch, const u64 action, const u128& cumulative_bet, const String& checkpoint)
{
    if (betting_round >= 4 || action >= 3 || !valid_hash(checkpoint)) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_ACTION_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, address);
    append_segment(message, decimal_u64(betting_round));
    append_segment(message, decimal_u64(epoch));
    append_segment(message, decimal_u64(action));
    append_segment(message, decimal_u128(cumulative_bet));
    append_segment(message, checkpoint);
    return crypto::sha256::hash(message);
}

String checkpoint_step(const String& table, const u64 hand_id, const String& checkpoint, const u64 phase,
                       const u64 event_round, const u64 epoch, const String& address, const u64 event,
                       const u128& amount, const String& data_hash)
{
    if (!valid_hash(checkpoint) || (data_hash.len() != 0 && !valid_hash(data_hash))) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_CHECKPOINT_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, checkpoint);
    append_segment(message, decimal_u64(phase));
    append_segment(message, decimal_u64(event_round));
    append_segment(message, decimal_u64(epoch));
    append_segment(message, address);
    append_segment(message, decimal_u64(event));
    append_segment(message, decimal_u128(amount));
    append_segment(message, data_hash);
    return crypto::sha256::hash(message);
}

String start_checkpoint(const String& table, const u64 hand_id, const u64 start_height,
                        const Vec<String>& addresses, const Vec<u128>& stacks)
{
    if (addresses.len() < 2 || addresses.len() != stacks.len()) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_START_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, decimal_u64(start_height));
    String checkpoint = crypto::sha256::hash(message);
    Vec<u128> remaining_stacks = stacks.clone();
    for (const String& address : addresses) {
        u128 stack = remaining_stacks.remove(0);
        checkpoint = checkpoint_step(table, hand_id, checkpoint, 0, 0, 0, address, 1, stack, "");
    }
    return checkpoint;
}

String continue_hash(const String& table, const u64 hand_id, const String& address, const u128& result_stack,
                     const String& checkpoint)
{
    if (!valid_hash(checkpoint)) {
        return "";
    }
    String message = "MMX_PARALLEL_POKER_CONTINUE_V1";
    append_segment(message, table);
    append_segment(message, decimal_u64(hand_id));
    append_segment(message, address);
    append_segment(message, decimal_u128(result_stack));
    append_segment(message, checkpoint);
    return crypto::sha256::hash(message);
}

String auth_hash(const String& dealer, const String& challenge, const u64 expires_at, const String& address)
{
    String message = "MMX_POKER_DEALER_AUTH_V1";
    append_segment(message, dealer);
    append_segment(message, challenge);
    append_segment(message, decimal_u64(expires_at));
    append_segment(message, address);
    return crypto::sha256::hash(message);
}

} // namespace protocol
} // namespace poker
