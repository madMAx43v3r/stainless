// MMX poker dealer. Routing, authentication, versioned state, chain rollback,
// table discovery, and dynamic scaling live in Stainless.

use rust::{String, Vec, println};
use rust::stainless_http::{Client, Server};
use kvstore::{JsonTable1};

namespace poker {

struct ConfigError : stainless::Exception {
};

void require_config(const bool condition, const String& message) throws ConfigError
{
    if (!condition) {
        throw ConfigError{stainless::Exception(String(message))};
    }
}

String append(const String& left, const String& right)
{
    String result = left.clone();
    result.push_str(right);
    return result;
}

String decimal(const u64 value)
{
    return crypto::uint_decimal(u128(value));
}

u128 decimal_value(const var& value) throws ConfigError
{
    String json = value.to_json();
    require_config(json.starts_with("\""),
                   "u64/u128 JSON values must be decimal strings");
    try {
        return crypto::parse_decimal_u128(String(value));
    } catch (const crypto::DecimalError& error) {
        throw ConfigError{stainless::Exception(String(error.message))};
    }
}

u128 amount(const var& value) throws ConfigError
{
    return decimal_value(value);
}

u64 integer(const var& value) throws ConfigError
{
    u128 exact = decimal_value(value);
    require_config(exact <= 18446744073709551615,
                   "integer exceeds the u64 range");
    return u64(exact);
}

String contract_u64(const u64 value)
{
    return crypto::uint_hex(u128(value));
}

String contract_amount(const u128& value)
{
    return crypto::uint_hex(value);
}

String quantity(const u128& value)
{
    return crypto::uint_decimal(value);
}

var public_template(const var& item)
{
    return {
        id: String(item.id),
        currency: String(item.currency),
        small_blind: String(item.small_blind),
        min_stack_blinds: u32(item.min_stack_blinds),
        max_players: u32(item.max_players),
        start_delay: String(item.start_delay),
        game_timeout: String(item.game_timeout),
        player_timeout: String(item.player_timeout),
        rake_bps: u32(item.rake_bps),
        min_rake: String(item.min_rake),
        min_available: u32(item.min_available),
    };
}

var public_table_status(const var& status)
    throws stainless::JsonError, ConfigError
{
    var start_height = null;
    var refund_height = null;
    if (status.start_height != null) {
        start_height = decimal(integer(status.start_height));
    }
    if (status.refund_height != null) {
        refund_height = decimal(integer(status.refund_height));
    }
    return {
        table_open: u64(status.table_open) != 0,
        player_count: decimal(integer(status.player_count)),
        start_height: start_height,
        refund_height: refund_height,
        dealer_rake: String(status.dealer_rake),
        transcript_hash: status.transcript_hash,
        hand_id: decimal(integer(status.hand_id)),
        active_count: u32(status.active_count),
        waiting_count: u32(status.waiting_count),
    };
}

var public_table_config(const var& config)
{
    return {
        currency: String(config.currency),
        dealer: String(config.dealer),
        small_blind: String(config.small_blind),
        min_stack: String(config.min_stack),
        max_players: u32(config.max_players),
        start_delay: String(config.start_delay),
        game_timeout: String(config.game_timeout),
        player_timeout: String(config.player_timeout),
        rake_bps: u32(config.rake_bps),
        min_rake: String(config.min_rake),
    };
}

var public_table(const var& table)
    throws stainless::JsonError, ConfigError
{
    var result = {
        address: String(table.address),
        template_id: String(table.template_id),
        deployment_height: decimal(integer(table.deployment_height)),
        confirmed: u64(table.confirmed) != 0,
        reachable: u64(table.reachable) != 0,
    };
    if (table.last_seen_height != null) {
        result.last_seen_height = decimal(integer(table.last_seen_height));
    }
    if (table.status != null) {
        result.status = public_table_status(table.status);
    }
    if (table.config != null) {
        result.config = public_table_config(table.config);
    }
    return result;
}

var public_chain(const var& chain)
    throws stainless::JsonError, ConfigError
{
    var tables = [];
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        tables.push(public_table(chain.tables[i]));
    }
    return {
        height: decimal(integer(chain.height)),
        time: decimal(integer(chain.time)),
        hash: String(chain.hash),
        synced: u64(chain.synced) != 0,
        tables: tables,
    };
}

void validate_config(const var& config) throws ConfigError, stainless::JsonError
{
    require_config(String(config.listen).len() > 0, "missing listen address");
    require_config(String(config.node_url).len() > 0, "missing node_url");
    require_config(String(config.data_dir).len() > 0, "missing data_dir");
    require_config(String(config.poker_binary).len() > 0, "missing poker_binary");
    require_config(String(config.poker_binary) != "MMX" &&
                   wallet::validate_address(String(config.poker_binary)),
                   "poker_binary is not an MMX address");
    require_config(String(config.dealer) != "MMX" &&
                   wallet::validate_address(String(config.dealer)),
                   "dealer is not an MMX address");
    require_config(config.templates.len() > 0, "at least one table template is required");
    require_config(integer(config.poll_interval_ms) > 0,
                   "poll_interval_ms must be positive");
    require_config(integer(config.request_timeout_ms) > 0,
                   "request_timeout_ms must be positive");
    require_config(integer(config.pending_timeout_blocks) > 0,
                   "pending_timeout_blocks must be positive");
    require_config(u64(config.max_deploy_per_sync) > 0,
                   "max_deploy_per_sync must be positive");
    require_config(u64(config.wallet_index) <= 4294967295,
                   "wallet_index exceeds the node API range");

    for (usize i = 0; i < config.templates.len(); i += 1) {
        var item = config.templates[i];
        require_config(String(item.id).len() > 0, "template id is required");
        require_config(wallet::validate_address(String(item.currency)),
                       "template currency is not an MMX address");
        require_config(amount(item.small_blind) > 0, "small_blind must be positive");
        require_config(u64(item.min_stack_blinds) >= 2,
                       "min_stack_blinds must be at least two");
        require_config(u64(item.max_players) >= 2 && u64(item.max_players) <= 10,
                       "max_players must be between two and ten");
        require_config(integer(item.start_delay) > 0, "start_delay must be positive");
        require_config(integer(item.game_timeout) > 0, "game_timeout must be positive");
        require_config(integer(item.player_timeout) > 0, "player_timeout must be positive");
        require_config(u64(item.rake_bps) <= 10000, "rake_bps exceeds 100 percent");
        require_config(amount(item.min_rake) <= amount(item.small_blind),
                       "min_rake exceeds small_blind");
        require_config(u64(item.min_available) > 0, "min_available must be positive");
        for (usize j = 0; j < i; j += 1) {
            require_config(String(config.templates[j].id) != String(item.id),
                           "template ids must be unique");
        }
    }
}

var public_config(const var& config) throws stainless::JsonError
{
    var templates = [];
    for (usize i = 0; i < config.templates.len(); i += 1) {
        templates.push(public_template(config.templates[i]));
    }
    return {
        dealer: String(config.dealer),
        poker_binary: String(config.poker_binary),
        templates: templates,
        websocket_path: "/v1/ws",
        protocol_version: 1,
    };
}

var empty_chain()
{
    return {
        height: "0",
        time: "0",
        hash: "",
        synced: false,
        checkpoints: [],
        tables: [],
    };
}

var load_state(const JsonTable1<String>& store, const String& key, const var& fallback)
    throws stainless::Exception
{
    var loaded = null;
    if (!store.find(key, loaded)) {
        return fallback;
    }
    return loaded;
}

void save_pending(const JsonTable1<String>& store, const var& pending)
    throws stainless::Exception
{
    store.insert("pending", pending.clone());
    u32 next = store.current_version() + 1;
    bool committed = false;
    if (next != 0) {
        committed = store.commit(next);
    }
    if (!committed) {
        throw ConfigError{stainless::Exception("failed to commit pending table state")};
    }
}

var node_get(const Client& node, const String& path)
    throws stainless::RustError, stainless::JsonError
{
    return http::get_json(node, path);
}

var node_post(const Client& node, const String& path, const var& body)
    throws stainless::RustError, stainless::JsonError
{
    return http::post_json(node, path, body);
}

String contract_path(const String& address, const String& method)
{
    String path = "/wapi/contract/call?id=";
    path.push_str(address);
    path.push_str("&method=");
    path.push_str(method);
    return path;
}

var contract_call(const Client& node, const String& address,
                  const String& method, const var& args)
    throws stainless::RustError, stainless::JsonError
{
    return node_post(node, contract_path(address, method), {args: args});
}

String header_path(const u64 height)
{
    String path = "/wapi/header?height=";
    path.push_str(decimal(height));
    return path;
}

bool table_known(const var& chain, const String& address) throws stainless::JsonError
{
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        if (String(chain.tables[i].address) == address) {
            return true;
        }
    }
    return false;
}

bool pending_known(const var& pending, const String& address)
    throws stainless::JsonError
{
    for (usize i = 0; i < pending.len(); i += 1) {
        if (String(pending[i].address) == address) {
            return true;
        }
    }
    return false;
}

void recover_reorg_deployments(const var& old_chain, const var& chain,
                               var& pending, const u64 tip_height)
    throws stainless::JsonError
{
    for (usize i = 0; i < old_chain.tables.len(); i += 1) {
        var table = old_chain.tables[i];
        String address = String(table.address);
        if (!table_known(chain, address) && !pending_known(pending, address)) {
            pending.push({
                address: move(address),
                template_id: String(table.template_id),
                deployment_height: decimal(tip_height),
                confirmed: false,
            });
        }
    }
}

var get_table(const var& chain, const String& address) throws stainless::JsonError
{
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        var table = chain.tables[i];
        if (String(table.address) == address) {
            return table;
        }
    }
    return null;
}

void refresh_tables(const Client& node, var& chain)
    throws stainless::JsonError, ConfigError
{
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        var table = chain.tables[i];
        try {
            table.status = contract_call(node, String(table.address),
                                         "get_table_status", []);
            table.config = contract_call(node, String(table.address),
                                         "get_config", []);
            table.confirmed = true;
            table.reachable = true;
            table.last_seen_height = decimal(integer(chain.height));
            table.error = null;
        } catch (const stainless::RustError& error) {
            table.reachable = false;
            table.error = String(error.message);
        }
    }
}

void merge_pending(const Client& node, const var& config, var& chain,
                   var& pending)
    throws stainless::JsonError, ConfigError
{
    var remaining = [];
    bool changed = false;
    u64 height = integer(chain.height);
    for (usize i = 0; i < pending.len(); i += 1) {
        var table = pending[i];
        bool confirmed = false;
        try {
            var status = contract_call(node, String(table.address),
                                       "get_table_status", []);
            var table_config = contract_call(node, String(table.address),
                                             "get_config", []);
            if (!table_known(chain, String(table.address))) {
                table.status = status;
                table.config = table_config;
                table.confirmed = true;
                table.reachable = true;
                table.last_seen_height = decimal(height);
                table.error = null;
                chain.tables.push(table);
            }
            confirmed = true;
            changed = true;
        } catch (const stainless::RustError& error) {
            u64 deployed = integer(table.deployment_height);
            if (height <= deployed + integer(config.pending_timeout_blocks)) {
                remaining.push(table);
            } else {
                changed = true;
            }
        }
    }
    if (changed) {
        pending = remaining;
    }
}

bool checkpoint_matches(const Client& node, const var& checkpoint, const u64 tip_height)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    u64 height = integer(checkpoint.height);
    if (height > tip_height) {
        return false;
    }
    var header = node_get(node, header_path(height));
    return String(header.hash).eq_ignore_ascii_case(String(checkpoint.hash));
}

bool rollback_if_needed(const Client& node, const JsonTable1<String>& store, const u64 tip_height, var& chain)
    throws stainless::Exception
{
    u64 old_height = integer(chain.height);
    if (old_height == 0 || String(chain.hash).len() == 0) {
        return false;
    }

    bool current_matches = false;
    if (old_height <= tip_height) {
        try {
            var current = node_get(node, header_path(old_height));
            current_matches = String(current.hash).eq_ignore_ascii_case(String(chain.hash));
        } catch (const stainless::RustError& error) {
            current_matches = false;
        }
    }
    if (current_matches) {
        return false;
    }

    u64 ancestor = 0;
    bool found = false;
    usize count = chain.checkpoints.len();
    for (; count > 0 && !found;) {
        count -= 1;
        var checkpoint = chain.checkpoints[count];
        try {
            if (checkpoint_matches(node, checkpoint, tip_height)) {
                ancestor = integer(checkpoint.height);
                found = true;
            }
        } catch (const stainless::RustError& error) {
        }
    }

    if (ancestor >= 4294967295) {
        throw ConfigError{stainless::Exception("rollback height exceeds kvstore range")};
    }
    bool reverted = store.revert(u32(ancestor + 1));
    if (!reverted) {
        throw ConfigError{stainless::Exception("kvstore could not revert chain state")};
    }
    chain = load_state(store, "chain", empty_chain());
    println!("chain rollback {} -> {}", old_height, ancestor);
    return true;
}

usize available_for_template(const var& chain, const var& pending,
                             const String& template_id)
    throws stainless::JsonError
{
    usize count = 0;
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        var table = chain.tables[i];
        if (String(table.template_id) == template_id && u64(table.confirmed) != 0 &&
            u64(table.reachable) != 0 &&
            u64(table.status.table_open) != 0 &&
            u64(table.status.active_count) + u64(table.status.waiting_count)
                < u64(table.config.max_players)) {
            count += 1;
        }
    }
    for (usize i = 0; i < pending.len(); i += 1) {
        if (String(pending[i].template_id) == template_id) {
            count += 1;
        }
    }
    return count;
}

String deploy_table(const Client& node, const var& config, const var& spec)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    var payload = {
        __type: "mmx.contract.Executable",
        binary: String(config.poker_binary),
        init_args: [
            String(spec.currency),
            String(config.dealer),
            contract_amount(amount(spec.small_blind)),
            contract_u64(u64(spec.min_stack_blinds)),
            contract_u64(u64(spec.max_players)),
            contract_u64(integer(spec.start_delay)),
            contract_u64(integer(spec.game_timeout)),
            contract_u64(integer(spec.player_timeout)),
            contract_u64(u64(spec.rake_bps)),
            contract_amount(amount(spec.min_rake)),
        ],
    };
    var request = {
        index: u32(config.wallet_index),
        payload: payload,
        options: {auto_send: true},
    };
    var result = node_post(node, "/wapi/wallet/deploy", request);
    return String(result);
}

bool scale_template(const Client& node, const var& config, const var& chain,
                    var& pending, const JsonTable1<String>& pending_store,
                    const var& spec)
    throws stainless::Exception
{
    if (u64(chain.synced) == 0 ||
        u64(available_for_template(chain, pending, String(spec.id)))
            >= u64(spec.min_available)) {
        return false;
    }
    String address = deploy_table(node, config, spec);
    var table = {
        address: String(address),
        template_id: String(spec.id),
        deployment_height: decimal(integer(chain.height)),
        confirmed: false,
    };
    pending.push(table);
    save_pending(pending_store, pending);
    println!("deployed pending poker table {} ({})", address, String(spec.id));
    return true;
}

void respond(const Server& server, const u64 request_id, const u16 status, const var& body)
{
    http::respond_json(server, request_id, status, body);
}

void respond_error(const Server& server, const u64 request_id, const u16 status, const String& code,
                   const String& message)
{
    respond(server, request_id, status,
            {error: {code: String(code), message: String(message)}});
}

var openapi()
{
    return {
        openapi: "3.1.0",
        info: {title: "MMX Poker Dealer API", version: "1"},
        paths: {
            "/v1/health": {get: {summary: "Dealer and chain status"}},
            "/v1/templates": {get: {summary: "Configured table classes"}},
            "/v1/tables": {get: {summary: "Tracked on-chain tables"}},
            "/v1/tables/{address}": {get: {summary: "One table snapshot"}},
            "/v1/ws": {get: {summary: "Player WebSocket protocol"}},
        },
    };
}

void handle_http(const Server& server, const var& event,
                 const var& config, const var& chain, const var& pending)
    throws stainless::JsonError, ConfigError
{
    u64 request_id = u64(event.request_id);
    String method = String(event.method);
    String path = String(event.path);
    if (method != "GET") {
        respond_error(server, request_id, 405, "method_not_allowed",
                      "the player REST API is read-only");
        return;
    }
    if (path == "/v1/health") {
        respond(server, request_id, 200, {
            ok: u64(chain.synced) != 0,
            height: decimal(integer(chain.height)),
            hash: chain.hash,
            tracked_tables: decimal(u64(chain.tables.len())),
            pending_tables: decimal(u64(pending.len())),
        });
    } else if (path == "/v1/templates") {
        respond(server, request_id, 200, public_config(config));
    } else if (path == "/v1/tables") {
        respond(server, request_id, 200, public_chain(chain));
    } else if (path == "/v1/openapi.json") {
        respond(server, request_id, 200, openapi());
    } else if (path.starts_with("/v1/tables/")) {
        String address = path.replace("/v1/tables/", "");
        var table = get_table(chain, address);
        if (table == null) {
            respond_error(server, request_id, 404, "table_not_found",
                          "the dealer does not track this table");
        } else {
            respond(server, request_id, 200, public_table(table));
        }
    } else {
        respond_error(server, request_id, 404, "not_found", "unknown API path");
    }
}

String auth_hash(const var& config, const var& session, const String& address)
    throws ConfigError
{
    return wallet::auth_hash(String(config.dealer), String(session.challenge),
                             integer(session.expires_at), address);
}

void ws_send(const Server& server, const u64 connection_id, const var& message)
{
    http::send_json(server, connection_id, message);
}

var open_session(const Server& server, const var& config, const u64 connection_id, const u64 now)
    throws stainless::RustError, stainless::JsonError
{
    String challenge = crypto::random_hex(32);
    u64 expires_at = now + 30;
    var session = {
        challenge: String(challenge),
        expires_at: decimal(expires_at),
        authenticated: false,
        address: "",
        public_key: "",
        table: "",
    };
    ws_send(server, connection_id, {
        type: "challenge",
        protocol_version: 1,
        dealer: String(config.dealer),
        challenge: String(challenge),
        expires_at: decimal(expires_at),
    });
    return session;
}

void authenticate(const Server& server, const var& config, const u64 connection_id, var& session,
                  const var& message, const u64 now)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    String address = String(message.address);
    String public_key = String(message.public_key);
    String signature = String(message.signature);
    if (now > integer(session.expires_at) ||
        !wallet::validate_address(address) ||
        !wallet::is_hex(public_key, 33) ||
        !wallet::is_hex(signature, 64)) {
        ws_send(server, connection_id,
                {type: "error", code: "authentication_invalid"});
        return;
    }
    String derived = wallet::address_from_public_key(public_key);
    String hash = auth_hash(config, session, address);
    if (derived != address || !wallet::verify(hash, public_key, signature)) {
        ws_send(server, connection_id,
                {type: "error", code: "authentication_failed"});
        return;
    }
    session.address = String(address);
    session.public_key = String(public_key);
    session.authenticated = true;
    session.challenge = "";
    ws_send(server, connection_id,
            {type: "authenticated", address: String(address)});
}

String inbox_key(const String& table, const u64 hand_id, const String& address, const String& kind,
                 const u64 round, const u64 epoch)
{
    String key = table.clone();
    key.push_str("/");
    key.push_str(decimal(hand_id));
    key.push_str("/");
    key.push_str(address);
    key.push_str("/");
    key.push_str(kind);
    key.push_str("/");
    key.push_str(decimal(round));
    key.push_str("/");
    key.push_str(decimal(epoch));
    return key;
}

bool validate_signed_submission(const Client& node, const var& session,
                                const var& message)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    String kind = String(message.type);
    if (kind != "commit" && kind != "action" && kind != "continue") {
        return true;
    }
    String signature = String(message.signature);
    if (!wallet::is_hex(signature, 64)) {
        return false;
    }
    var hash = null;
    if (kind == "commit") {
        hash = contract_call(node, String(session.table), "get_commit_hash",
                             [String(session.address), message.commitments]);
    } else if (kind == "action") {
        hash = contract_call(node, String(session.table), "get_action_hash", [
            String(session.address),
            contract_u64(integer(message.round)),
            contract_u64(integer(message.epoch)),
            contract_u64(u64(message.action)),
            contract_amount(amount(message.cumulative_bet)),
            message.checkpoint,
        ]);
    } else if (kind == "continue") {
        hash = contract_call(node, String(session.table), "get_continue_hash", [
            String(session.address),
            contract_amount(amount(message.result_stack)),
            message.checkpoint,
        ]);
    }
    return wallet::verify(String(hash), String(session.public_key), signature);
}

void accept_submission(const Client& node, const Server& server,
                       const u64 connection_id, const var& session,
                       const var& message, var& inbox)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    String kind = String(message.type);
    if (kind != "commit" && kind != "reveal" && kind != "action" &&
        kind != "show" && kind != "muck" && kind != "continue" &&
        kind != "leave") {
        ws_send(server, connection_id,
                {type: "error", code: "unknown_message_type"});
        return;
    }
    if (!validate_signed_submission(node, session, message)) {
        ws_send(server, connection_id,
                {type: "error", code: "signature_invalid"});
        return;
    }
    u64 hand_id = integer(message.hand_id);
    u64 round = integer(message.round);
    u64 epoch = integer(message.epoch);
    String key = inbox_key(String(session.table), hand_id, String(session.address),
                           kind, round, epoch);
    inbox.set(key, message);
    ws_send(server, connection_id, {
        type: "accepted",
        message_type: String(kind),
        hand_id: decimal(hand_id),
        round: decimal(round),
        epoch: decimal(epoch),
    });
}

void handle_session_message(const Client& node, const Server& server,
                            const var& config, const var& chain,
                            const u64 connection_id, var& session,
                            const var& message, var& inbox, const u64 now)
    throws stainless::RustError, stainless::JsonError, ConfigError
{
    String kind = String(message.type);
    if (kind == "auth") {
        authenticate(server, config, connection_id, session, message, now);
        return;
    }
    if (u64(session.authenticated) == 0) {
        ws_send(server, connection_id,
                {type: "error", code: "authentication_required"});
        return;
    }
    if (kind == "subscribe") {
        String address = String(message.table);
        var table = get_table(chain, address);
        if (table == null || u64(table.confirmed) == 0) {
            ws_send(server, connection_id,
                    {type: "error", code: "table_not_found"});
            return;
        }
        contract_call(node, address, "get_player_info", [session.address]);
        session.table = move(address);
        ws_send(server, connection_id,
                {type: "subscribed", table: public_table(table)});
        return;
    }
    if (String(session.table).len() == 0) {
        ws_send(server, connection_id,
                {type: "error", code: "subscription_required"});
        return;
    }
    accept_submission(node, server, connection_id, session, message, inbox);
}

} // namespace poker
