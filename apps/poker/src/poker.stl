// MMX poker dealer. JSON is confined to storage, HTTP, WebSocket, and MMX WAPI boundaries; dealer state and protocol
// decisions use typed Stainless structs

use rust::{Map, String, Vec, println};
use rust::stainless_http::{Client, Server};
use kvstore::{JsonTable1};

namespace poker {

// Invalid dealer configuration or externally supplied poker state

struct ConfigError : stainless::Exception {
};

void require_config(const bool condition, const String& message) throws ConfigError
{
    if (!condition) {
        throw ConfigError{stainless::Exception(String(message))};
    }
}

String append(const String& left, const String& right)
{
    String result = left.clone();
    result.push_str(right);
    return result;
}

// Parses a decimal-string amount at a JSON boundary

u128 amount(const var& value) throws ConfigError
{
    require_config(value.is_string(), "u64/u128 JSON values must be decimal strings");
    try {
        return crypto::parse_decimal_u128(String(value));
    } catch (const crypto::DecimalError& error) {
        throw ConfigError{stainless::Exception(String(error.message))};
    }
}

// Parses a decimal-string u64 at a JSON boundary

u64 integer(const var& value) throws ConfigError
{
    u128 exact = amount(value);
    require_config(exact <= 18446744073709551615, "integer exceeds the u64 range");
    return u64(exact);
}

String contract_u64(const u64 value)
{
    return crypto::uint_hex(u128(value));
}

String contract_amount(const u128& value)
{
    return crypto::uint_hex(value);
}

String decimal(const u64 value)
{
    return crypto::uint_decimal(u128(value));
}

String quantity(const u128& value)
{
    return crypto::uint_decimal(value);
}

void DealerConfig::validate() const throws ConfigError
{
    require_config(listen.len() > 0, "missing listen address");
    require_config(node_url.len() > 0, "missing node_url");
    require_config(data_dir.len() > 0, "missing data_dir");
    require_config(poker_binary.len() > 0, "missing poker_binary");
    require_config(poker_binary != "MMX" && wallet::validate_address(poker_binary),
                   "poker_binary is not an MMX address");
    require_config(dealer != "MMX" && wallet::validate_address(dealer),
                   "dealer is not an MMX address");
    require_config(templates.len() > 0, "at least one table template is required");
    require_config(poll_interval_ms > 0, "poll_interval_ms must be positive");
    require_config(request_timeout_ms > 0, "request_timeout_ms must be positive");
    require_config(pending_timeout_blocks > 0, "pending_timeout_blocks must be positive");
    require_config(max_deploy_per_sync > 0, "max_deploy_per_sync must be positive");

    for (usize i = 0; i < templates.len(); i += 1) {
        TableTemplate item = templates[i];
        require_config(item.id.len() > 0, "template id is required");
        require_config(wallet::validate_address(item.currency), "template currency is not an MMX address");
        require_config(item.small_blind > 0, "small_blind must be positive");
        require_config(item.min_stack_blinds >= 2, "min_stack_blinds must be at least two");
        require_config(item.max_players >= 2 && item.max_players <= 10, "max_players must be between two and ten");
        require_config(item.start_delay > 0, "start_delay must be positive");
        require_config(item.game_timeout > 0, "game_timeout must be positive");
        require_config(item.player_timeout > 0, "player_timeout must be positive");
        require_config(item.rake_bps <= 10000, "rake_bps exceeds 100 percent");
        require_config(item.min_rake <= item.small_blind, "min_rake exceeds small_blind");
        require_config(item.min_available > 0, "min_available must be positive");
        for (usize j = 0; j < i; j += 1) {
            require_config(templates[j].id != item.id, "template ids must be unique");
        }
    }
}

var DealerConfig::json_public() const throws stainless::JsonError
{
    var template_values = [];
    for (const TableTemplate& item : templates) {
        template_values.push(item.json_public());
    }
    return {
        dealer: dealer.clone(),
        poker_binary: poker_binary.clone(),
        templates: move(template_values),
        websocket_path: "/v1/ws",
        protocol_version: 1,
    };
}

var Table::json_public() const throws stainless::JsonError
{
    var result = {
        address: address.clone(),
        template_id: template_id.clone(),
        deployment_height: decimal(deployment_height),
        confirmed: confirmed,
        reachable: reachable,
    };
    if (last_seen_height.has_value()) {
        result.last_seen_height = decimal(last_seen_height.value_or(0));
    }
    if (status.has_value()) {
        result.status = status.value_or(TableStatus()).json();
    }
    if (config.has_value()) {
        result.config = config.value_or(TableConfig()).json();
    }
    return result;
}

var ChainState::json_public() const throws stainless::JsonError
{
    var table_values = [];
    for (const Table& table : tables) {
        table_values.push(table.json_public());
    }
    return {
        height: decimal(height),
        time: decimal(time),
        hash: hash.clone(),
        synced: synced,
        tables: move(table_values),
    };
}

ChainState load_chain(const JsonTable1<String>& store) throws stainless::Exception
{
    var loaded = null;
    if (!store.find("chain", loaded)) {
        return ChainState();
    }
    return ChainState::parse(loaded);
}

Vec<PendingTable> load_pending(const JsonTable1<String>& store) throws stainless::Exception
{
    var loaded = null;
    if (!store.find("pending", loaded)) {
        return Vec<PendingTable>();
    }
    return PendingTable::parse_all(loaded);
}

void save_pending(const JsonTable1<String>& store, const Vec<PendingTable>& pending) throws stainless::Exception
{
    store.insert("pending", PendingTable::json_all(pending));
    u32 next = store.current_version() + 1;
    bool committed = false;
    if (next != 0) {
        committed = store.commit(next);
    }
    if (!committed) {
        throw ConfigError{stainless::Exception("failed to commit pending table state")};
    }
}

// MMX WAPI JSON boundary

var node_get(const Client& node, const String& path) throws stainless::RustError, stainless::JsonError
{
    return http::get_json(node, path);
}

// MMX WAPI JSON boundary

var node_post(const Client& node, const String& path, const var& body)
    throws stainless::RustError, stainless::JsonError
{
    return http::post_json(node, path, body);
}

String contract_path(const String& address, const String& method)
{
    String path = "/wapi/contract/call?id=";
    path.push_str(address);
    path.push_str("&method=");
    path.push_str(method);
    return path;
}

// MMX contract JSON boundary; callers convert the result to a typed value immediately

var contract_call(const Client& node, const String& address, const String& method, const var& args)
    throws stainless::RustError, stainless::JsonError
{
    return node_post(node, contract_path(address, method), {args: args});
}

String header_path(const u64 height)
{
    String path = "/wapi/header?height=";
    path.push_str(decimal(height));
    return path;
}

usize find_table_index(const ChainState& chain, const String& address)
{
    for (usize i = 0; i < chain.tables.len(); i += 1) {
        if (chain.tables[i].address == address) {
            return i;
        }
    }
    return chain.tables.len();
}

bool table_known(const ChainState& chain, const String& address)
{
    return find_table_index(chain, address) != chain.tables.len();
}

bool pending_known(const Vec<PendingTable>& pending, const String& address)
{
    for (const PendingTable& table : pending) {
        if (table.address == address) {
            return true;
        }
    }
    return false;
}

bool recover_reorg_deployments(const ChainState& old_chain, const ChainState& chain,
                               Vec<PendingTable>& pending, const u64 tip_height)
{
    bool changed = false;
    for (const Table& table : old_chain.tables) {
        if (!table_known(chain, table.address) && !pending_known(pending, table.address)) {
            pending.push(PendingTable{String(table.address), String(table.template_id), tip_height});
            changed = true;
        }
    }
    return changed;
}

void refresh_tables(const Client& node, ChainState& chain) throws stainless::JsonError, ConfigError
{
    u64 height = chain.height;
    for (auto& table : chain.tables) {
        try {
            var status = contract_call(node, table.address, "get_table_status", []);
            var config = contract_call(node, table.address, "get_config", []);
            table.status = optional<TableStatus>(TableStatus::parse(status));
            table.config = optional<TableConfig>(TableConfig::parse(config));
            table.confirmed = true;
            table.reachable = true;
            table.last_seen_height = optional<u64>(height);
            table.error = optional<String>();
        } catch (const stainless::RustError& error) {
            table.reachable = false;
            table.error = optional<String>(String(error.message));
        }
    }
}

bool merge_pending(const Client& node, const DealerConfig& config, ChainState& chain, Vec<PendingTable>& pending)
    throws stainless::JsonError, ConfigError
{
    Vec<PendingTable> remaining;
    bool changed = false;
    for (const PendingTable& pending_table : pending) {
        try {
            var status = contract_call(node, pending_table.address, "get_table_status", []);
            var table_config = contract_call(node, pending_table.address, "get_config", []);
            if (!table_known(chain, pending_table.address)) {
                Table table;
                table.address = String(pending_table.address);
                table.template_id = String(pending_table.template_id);
                table.deployment_height = pending_table.deployment_height;
                table.confirmed = true;
                table.reachable = true;
                table.last_seen_height = optional<u64>(chain.height);
                table.status = optional<TableStatus>(TableStatus::parse(status));
                table.config = optional<TableConfig>(TableConfig::parse(table_config));
                chain.tables.push(move(table));
            }
            changed = true;
        } catch (const stainless::RustError& error) {
            if (chain.height <= pending_table.deployment_height + config.pending_timeout_blocks) {
                remaining.push(pending_table);
            } else {
                changed = true;
            }
        }
    }
    if (changed) {
        pending = move(remaining);
    }
    return changed;
}

bool checkpoint_matches(const Client& node, const Checkpoint& checkpoint, const u64 tip_height)
    throws stainless::RustError, stainless::JsonError
{
    if (checkpoint.height > tip_height) {
        return false;
    }
    var header = node_get(node, header_path(checkpoint.height));
    return String(header.hash).eq_ignore_ascii_case(checkpoint.hash);
}

bool rollback_if_needed(const Client& node, const JsonTable1<String>& store, const u64 tip_height,
                        ChainState& chain) throws stainless::Exception
{
    u64 old_height = chain.height;
    if (old_height == 0 || chain.hash.len() == 0) {
        return false;
    }

    bool current_matches = false;
    if (old_height <= tip_height) {
        try {
            var current = node_get(node, header_path(old_height));
            current_matches = String(current.hash).eq_ignore_ascii_case(chain.hash);
        } catch (const stainless::RustError& error) {
            current_matches = false;
        }
    }
    if (current_matches) {
        return false;
    }

    u64 ancestor = 0;
    bool found = false;
    usize count = chain.checkpoints.len();
    for (; count > 0 && !found;) {
        count -= 1;
        try {
            if (checkpoint_matches(node, chain.checkpoints[count], tip_height)) {
                ancestor = chain.checkpoints[count].height;
                found = true;
            }
        } catch (const stainless::RustError& error) {
        }
    }

    if (ancestor >= 4294967295) {
        throw ConfigError{stainless::Exception("rollback height exceeds kvstore range")};
    }
    if (!store.revert(u32(ancestor + 1))) {
        throw ConfigError{stainless::Exception("kvstore could not revert chain state")};
    }
    chain = load_chain(store);
    println!("chain rollback {} -> {}", old_height, ancestor);
    return true;
}

usize available_for_template(const ChainState& chain, const Vec<PendingTable>& pending, const String& template_id)
{
    usize count = 0;
    for (const Table& table : chain.tables) {
        if (table.template_id == template_id && table.confirmed && table.reachable && table.status.has_value() &&
            table.config.has_value()) {
            TableStatus status = table.status.value_or(TableStatus());
            TableConfig config = table.config.value_or(TableConfig());
            if (status.table_open && status.active_count + status.waiting_count < config.max_players) {
                count += 1;
            }
        }
    }
    for (const PendingTable& table : pending) {
        if (table.template_id == template_id) {
            count += 1;
        }
    }
    return count;
}

String deploy_table(const Client& node, const DealerConfig& config, const TableTemplate& spec)
    throws stainless::RustError, stainless::JsonError
{
    var payload = {
        __type: "mmx.contract.Executable",
        binary: String(config.poker_binary),
        init_args: [
            String(spec.currency),
            String(config.dealer),
            contract_amount(spec.small_blind),
            contract_u64(u64(spec.min_stack_blinds)),
            contract_u64(u64(spec.max_players)),
            contract_u64(spec.start_delay),
            contract_u64(spec.game_timeout),
            contract_u64(spec.player_timeout),
            contract_u64(u64(spec.rake_bps)),
            contract_amount(spec.min_rake),
        ],
    };
    var request = {
        index: config.wallet_index,
        payload: move(payload),
        options: {auto_send: true},
    };
    var result = node_post(node, "/wapi/wallet/deploy", request);
    return String(result);
}

bool scale_template(const Client& node, const DealerConfig& config, const ChainState& chain,
                    Vec<PendingTable>& pending, const JsonTable1<String>& pending_store, const TableTemplate& spec)
    throws stainless::Exception
{
    if (!chain.synced || available_for_template(chain, pending, spec.id) >= usize(spec.min_available)) {
        return false;
    }
    String address = deploy_table(node, config, spec);
    pending.push(PendingTable{String(address), String(spec.id), chain.height});
    save_pending(pending_store, pending);
    println!("deployed pending poker table {} ({})", address, spec.id);
    return true;
}

// Player HTTP API boundary

void respond(const Server& server, const u64 request_id, const u16 status, const var& body)
{
    http::respond_json(server, request_id, status, body);
}

void respond_error(const Server& server, const u64 request_id, const u16 status, const String& code,
                   const String& message)
{
    respond(server, request_id, status, {error: {code: String(code), message: String(message)}});
}

var openapi()
{
    return {
        openapi: "3.1.0",
        info: {title: "MMX Poker Dealer API", version: "1"},
        paths: {
            "/v1/health": {get: {summary: "Dealer and chain status"}},
            "/v1/templates": {get: {summary: "Configured table classes"}},
            "/v1/tables": {get: {summary: "Tracked on-chain tables"}},
            "/v1/tables/{address}": {get: {summary: "One table snapshot"}},
            "/v1/ws": {get: {summary: "Player WebSocket protocol"}},
        },
    };
}

// Player HTTP event boundary

void handle_http(const Server& server, const var& event, const DealerConfig& config, const ChainState& chain,
                 const Vec<PendingTable>& pending) throws stainless::JsonError
{
    u64 request_id = u64(event.request_id);
    String method = String(event.method);
    String path = String(event.path);
    if (method != "GET") {
        respond_error(server, request_id, 405, "method_not_allowed", "the player REST API is read-only");
        return;
    }
    if (path == "/v1/health") {
        respond(server, request_id, 200, {
            ok: chain.synced,
            height: decimal(chain.height),
            hash: String(chain.hash),
            tracked_tables: decimal(u64(chain.tables.len())),
            pending_tables: decimal(u64(pending.len())),
        });
    } else if (path == "/v1/templates") {
        respond(server, request_id, 200, config.json_public());
    } else if (path == "/v1/tables") {
        respond(server, request_id, 200, chain.json_public());
    } else if (path == "/v1/openapi.json") {
        respond(server, request_id, 200, openapi());
    } else if (path.starts_with("/v1/tables/")) {
        String address = path.replace("/v1/tables/", "");
        usize index = find_table_index(chain, address);
        if (index == chain.tables.len()) {
            respond_error(server, request_id, 404, "table_not_found", "the dealer does not track this table");
        } else {
            respond(server, request_id, 200, chain.tables[index].json_public());
        }
    } else {
        respond_error(server, request_id, 404, "not_found", "unknown API path");
    }
}

String auth_hash(const DealerConfig& config, const Session& session, const String& address)
{
    return protocol::auth_hash(config.dealer, session.challenge, session.expires_at, address);
}

// Player WebSocket JSON boundary

void ws_send(const Server& server, const u64 connection_id, const var& message)
{
    http::send_json(server, connection_id, message);
}

Session open_session(const Server& server, const DealerConfig& config, const u64 connection_id, const u64 now)
    throws stainless::RustError
{
    String challenge = crypto::random_hex(32);
    Session session;
    session.challenge = String(challenge);
    session.expires_at = now + 30;
    ws_send(server, connection_id, {
        type: String(DealerEventKind::Challenge),
        protocol_version: 1,
        dealer: String(config.dealer),
        challenge: move(challenge),
        expires_at: decimal(session.expires_at),
    });
    return session;
}

void authenticate(const Server& server, const DealerConfig& config, const u64 connection_id, Session& session,
                  const Submission& message, const u64 now) throws stainless::RustError
{
    if (now > session.expires_at || !wallet::validate_address(message.address) ||
        !wallet::is_hex(message.public_key, 33) || !wallet::is_hex(message.signature, 64)) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "authentication_invalid"});
        return;
    }
    String derived = wallet::address_from_public_key(message.public_key);
    String hash = auth_hash(config, session, message.address);
    if (derived != message.address || !wallet::verify(hash, message.public_key, message.signature)) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "authentication_failed"});
        return;
    }
    session.address = String(message.address);
    session.public_key = String(message.public_key);
    session.authenticated = true;
    session.challenge = "";
    ws_send(server, connection_id,
            {type: String(DealerEventKind::Authenticated), address: String(message.address)});
}

String inbox_key(const String& table, const u64 hand_id, const String& address, const SubmissionKind kind,
                 const u64 round, const u64 epoch)
{
    String key = table.clone();
    key.push_str("/");
    key.push_str(decimal(hand_id));
    key.push_str("/");
    key.push_str(address);
    key.push_str("/");
    key.push_str(String(kind));
    key.push_str("/");
    key.push_str(decimal(round));
    key.push_str("/");
    key.push_str(decimal(epoch));
    return key;
}

bool validate_signed_submission(const Client& node, const Session& session, const Submission& message)
    throws stainless::RustError, stainless::JsonError
{
    if (message.kind != SubmissionKind::Commit && message.kind != SubmissionKind::Action &&
        message.kind != SubmissionKind::Continue) {
        return true;
    }
    if (!wallet::is_hex(message.signature, 64)) {
        return false;
    }
    String hash;
    if (message.kind == SubmissionKind::Commit) {
        var result = contract_call(node, session.table, "get_commit_hash", [String(session.address),
                                   strings_json(message.commitments)]);
        hash = String(result);
    } else if (message.kind == SubmissionKind::Action) {
        var result = contract_call(node, session.table, "get_action_hash", [
            String(session.address),
            contract_u64(message.round),
            contract_u64(message.epoch),
            contract_u64(u64(message.action)),
            contract_amount(message.cumulative_bet),
            String(message.checkpoint),
        ]);
        hash = String(result);
    } else {
        var result = contract_call(node, session.table, "get_continue_hash", [
            String(session.address),
            contract_amount(message.result_stack),
            String(message.checkpoint),
        ]);
        hash = String(result);
    }
    return wallet::verify(hash, session.public_key, message.signature);
}

void accept_submission(const Client& node, const Server& server, const u64 connection_id, const Session& session,
                       const Submission& message, Map<String, Submission>& inbox)
    throws stainless::RustError, stainless::JsonError
{
    if (message.kind != SubmissionKind::Commit && message.kind != SubmissionKind::Reveal &&
        message.kind != SubmissionKind::Action && message.kind != SubmissionKind::Show &&
        message.kind != SubmissionKind::Muck && message.kind != SubmissionKind::Continue &&
        message.kind != SubmissionKind::Leave) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "unknown_message_type"});
        return;
    }
    if (!validate_signed_submission(node, session, message)) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "signature_invalid"});
        return;
    }
    String key = inbox_key(session.table, message.hand_id, session.address, message.kind, message.round, message.epoch);
    inbox.insert(move(key), message);
    ws_send(server, connection_id, {
        type: String(DealerEventKind::Accepted),
        message_type: String(message.kind),
        hand_id: decimal(message.hand_id),
        round: decimal(message.round),
        epoch: decimal(message.epoch),
    });
}

void handle_session_message(const Client& node, const Server& server, const DealerConfig& config,
                            const ChainState& chain, const u64 connection_id, Session& session,
                            const Submission& message, Map<String, Submission>& inbox, const u64 now)
    throws stainless::RustError, stainless::JsonError
{
    if (message.kind == SubmissionKind::Auth) {
        authenticate(server, config, connection_id, session, message, now);
        return;
    }
    if (!session.authenticated) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "authentication_required"});
        return;
    }
    if (message.kind == SubmissionKind::Subscribe) {
        usize index = find_table_index(chain, message.table);
        if (index == chain.tables.len() || !chain.tables[index].confirmed) {
            ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "table_not_found"});
            return;
        }
        contract_call(node, message.table, "get_player_info", [String(session.address)]);
        session.table = String(message.table);
        ws_send(server, connection_id,
                {type: String(DealerEventKind::Subscribed), table: chain.tables[index].json_public()});
        return;
    }
    if (session.table.len() == 0) {
        ws_send(server, connection_id, {type: String(DealerEventKind::Error), code: "subscription_required"});
        return;
    }
    accept_submission(node, server, connection_id, session, message, inbox);
}

} // namespace poker
